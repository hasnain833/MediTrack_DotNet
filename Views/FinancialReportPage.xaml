<Page
    x:Class="DChemist.Views.FinancialReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:utils="using:DChemist.Utils"
    mc:Ignorable="d"
    RequestedTheme="Light"
    Background="{StaticResource AppBackgroundBrush}">

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Actions Row -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="48,24,48,0">
            <CalendarDatePicker Date="{x:Bind ViewModel.ReportDate, Mode=TwoWay}"
                                PlaceholderText="Select Date"
                                VerticalAlignment="Center" Width="200"/>
            <Button Content="Export CSV"
                    Command="{x:Bind ViewModel.ExportCsvCommand}"
                    Style="{StaticResource PremiumButtonStyle}"
                    Height="36" Padding="20,0"/>
        </StackPanel>

        <!-- KPI Cards Row -->
        <Grid Grid.Row="1" ColumnSpacing="20" Margin="48,24,48,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Daily Sales -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="32" Height="32" Background="#E6F4EA" CornerRadius="8">
                            <FontIcon Glyph="&#xE8C1;" FontSize="16" Foreground="#16A34A"/>
                        </Border>
                        <TextBlock Text="Daily Sales" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Report.NetSales, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                               FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- Daily Earning (Profit) -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="32" Height="32" Background="#EFF6FF" CornerRadius="8">
                            <FontIcon Glyph="&#xE8B9;" FontSize="16" Foreground="#2563EB"/>
                        </Border>
                        <TextBlock Text="Daily Earning (Profit)" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Report.TotalProfit, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                               FontSize="28" FontWeight="Bold" Foreground="#2563EB"/>
                </StackPanel>
            </Border>

            <!-- Total Bills -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="20">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Width="32" Height="32" Background="#F3F4F6" CornerRadius="8">
                            <FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="#4B5563"/>
                        </Border>
                        <TextBlock Text="Daily Bill Numbers" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.Report.TotalSalesCount, Mode=OneWay}"
                               FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Section: Master-Detail -->
        <Grid Grid.Row="2" ColumnSpacing="24" Margin="48,0,48,48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2.5*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: List of Bills -->
            <Border Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="Bills" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
                    
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Report.DailyBills, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedBill, Mode=TwoWay}"
                              SelectionMode="Single"
                              IsItemClickEnabled="True">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Padding="8,12" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="{Binding BillNo}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Customer}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="14" Foreground="#16A34A" HorizontalAlignment="Right"/>
                                            <TextBlock Text="{Binding Date}" FontSize="11" Foreground="#9CA3AF" HorizontalAlignment="Right"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>
                </Grid>
            </Border>

            <!-- Right: Bill Details -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" BorderBrush="#E5E7EB" BorderThickness="1" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,0,0,16">
                        <TextBlock Text="Bill Details" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedBill.BillNo, Mode=OneWay}" FontSize="14" FontWeight="SemiBold" Foreground="#64748B" VerticalAlignment="Center"/>
                        <Border Background="#DBEAFE" CornerRadius="6" Padding="8,4" VerticalAlignment="Center"
                                Visibility="{x:Bind ViewModel.SelectedBill, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.SelectedBillDetails.Status, Mode=OneWay}" FontSize="12" Foreground="#1E40AF" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <!-- Empty state -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{x:Bind ViewModel.SelectedBillDetails, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE8B3;" FontSize="32" Foreground="#CBD5E1" Margin="0,0,0,12"/>
                        <TextBlock Text="Select a bill to view details" Foreground="#94A3B8" FontSize="14"/>
                    </StackPanel>

                    <!-- Items Grid -->
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.SelectedBillDetails.Items, Mode=OneWay}"
                              Visibility="{x:Bind ViewModel.SelectedBillDetails, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Inverse'}"
                              SelectionMode="None">
                        <ListView.Header>
                            <Grid Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,2" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Item" FontWeight="SemiBold" FontSize="12" Foreground="#64748B"/>
                                <TextBlock Grid.Column="1" Text="Qty" FontWeight="SemiBold" FontSize="12" Foreground="#64748B" TextAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="S.Price" FontWeight="SemiBold" FontSize="12" Foreground="#64748B" TextAlignment="Right"/>
                                <TextBlock Grid.Column="3" Text="Subtotal" FontWeight="SemiBold" FontSize="12" Foreground="#64748B" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="P.Price" FontWeight="SemiBold" FontSize="12" Foreground="#64748B" TextAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="Profit" FontWeight="SemiBold" FontSize="12" Foreground="#64748B" TextAlignment="Right"/>
                            </Grid>
                        </ListView.Header>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="12,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*"/>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding MedicineName}" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding NetQuantity}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding NetSubtotal, Converter={StaticResource CurrencyConverter}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding PurchasePrice, Converter={StaticResource CurrencyConverter}}" FontSize="13" Foreground="#9CA3AF" VerticalAlignment="Center" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="{Binding Profit, Converter={StaticResource CurrencyConverter}}" FontSize="13" FontWeight="Bold" Foreground="#2563EB" VerticalAlignment="Center" TextAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="MinHeight" Value="36"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <!-- Summary Footer -->
                    <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="8" Padding="16" Margin="0,16,0,0"
                            Visibility="{x:Bind ViewModel.SelectedBillDetails, Mode=OneWay, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Inverse'}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="24">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Total Amount" FontSize="12" Foreground="#64748B"/>
                                    <TextBlock Text="{x:Bind ViewModel.SelectedBillDetails.GrandTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock Text="Total Profit" FontSize="12" Foreground="#64748B" HorizontalAlignment="Right"/>
                                <TextBlock Text="{x:Bind ViewModel.SelectedBillDetails.TotalProfit, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="20" FontWeight="Bold" Foreground="#2563EB" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status + Loading -->
        <TextBlock Grid.Row="2" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16"
                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="13"/>

        <ProgressRing Grid.RowSpan="3" IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Width="48" Height="48"
                      Foreground="{StaticResource AccentAccent}"/>
    </Grid>
</Page>
