<Page
    x:Class="DChemist.Views.FinancialReportPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:repo="using:DChemist.Repositories"
    xmlns:models="using:DChemist.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A94A6"/>
            <Setter Property="CharacterSpacing" Value="60"/>
        </Style>
        <Style x:Key="Kpi" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E9EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Toolbar: pick the day ============ -->
        <Border Background="White" BorderBrush="#E5E9EF" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Daily Report" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.PrevDayCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" ToolTipService.ToolTip="Previous day">
                        <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                    </Button>
                    <CalendarDatePicker Date="{x:Bind ViewModel.ReportDate, Mode=TwoWay}" DateFormat="{}{day.integer} {month.abbreviated} {year.full}" Width="150"/>
                    <Button Command="{x:Bind ViewModel.NextDayCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" ToolTipService.ToolTip="Next day">
                        <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                    </Button>
                    <TextBlock Text="{x:Bind ViewModel.ReportDateText, Mode=OneWay}" Foreground="#4B5563" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#4B5563" VerticalAlignment="Center"/>
                    <Button Content="Export CSV" Command="{x:Bind ViewModel.ExportCsvCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ The day in numbers ============ -->
        <Grid Grid.Row="1" Padding="16,12,16,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Kpi}">
                <StackPanel>
                    <TextBlock Text="BILLS" Style="{StaticResource ColHead}"/>
                    <TextBlock Text="{x:Bind ViewModel.Report.TotalSalesCount, Mode=OneWay}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Kpi}">
                <StackPanel>
                    <TextBlock Text="GROSS SALES" Style="{StaticResource ColHead}"/>
                    <TextBlock Text="{x:Bind ViewModel.Report.GrossSales, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Kpi}">
                <StackPanel>
                    <TextBlock Text="DISCOUNT · RETURNS" Style="{StaticResource ColHead}"/>
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="#B45309">
                        <Run Text="{x:Bind ViewModel.Report.TotalDiscount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"/> · <Run Text="{x:Bind ViewModel.Report.TotalReturns, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"/>
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Kpi}">
                <StackPanel>
                    <TextBlock Text="NET SALES" Style="{StaticResource ColHead}"/>
                    <TextBlock Text="{x:Bind ViewModel.Report.NetSales, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="SemiBold" Foreground="#0B6E99"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Kpi}" Background="#E7F7EF" BorderBrush="#BDE8D1">
                <StackPanel>
                    <TextBlock Text="PROFIT" Style="{StaticResource ColHead}" Foreground="#047857"/>
                    <TextBlock Text="{x:Bind ViewModel.Report.TotalProfit, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="SemiBold" Foreground="#047857"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ Bills of the day + selected bill ============ -->
        <Grid Grid.Row="2" Padding="16,12,16,16" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Background="White" BorderBrush="#E5E9EF" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="BILLS OF THE DAY" Style="{StaticResource ColHead}" Margin="14,10"/>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Report.DailyBills, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedBill, Mode=TwoWay}" SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="repo:SaleSummary">
                                <Grid Padding="14,8" BorderThickness="0,1,0,0" BorderBrush="#F1F4F8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{x:Bind BillNo}" FontFamily="Cascadia Mono, Consolas" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="1" Text="{x:Bind Customer}" FontSize="12" Foreground="#4B5563" TextTrimming="CharacterEllipsis" Margin="0,0,80,0"/>
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind TimeText}" FontSize="11" Foreground="#8A94A6" VerticalAlignment="Center"/>
                                        <Border Background="{x:Bind Status, Converter={StaticResource StatusToBackgroundConverter}}" CornerRadius="8" Padding="7,0">
                                            <TextBlock Text="{x:Bind Status}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind Status, Converter={StaticResource StatusToForegroundConverter}}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Grid.Row="1" Text="No bills on this day." Foreground="#8A94A6" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.Report.TotalSalesCount, Mode=OneWay, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#E5E9EF" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Padding="16,12" BorderBrush="#E5E9EF" BorderThickness="0,0,0,1">
                        <TextBlock Text="{x:Bind ViewModel.SelectedBill.BillNo, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ViewModel.SelectedBillDetails.Status, Mode=OneWay}" Foreground="#4B5563" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Grid.Row="1" Background="#F8F9FA" Padding="16,8" BorderBrush="#E5E9EF" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ITEM" Style="{StaticResource ColHead}"/>
                        <TextBlock Grid.Column="1" Text="QTY" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="2" Text="SALE PRICE" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="3" Text="COST" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="AMOUNT" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="5" Text="PROFIT" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                    </Grid>

                    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.SelectedBillDetails.Items, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:SaleItem">
                                <Grid Padding="16,7" BorderThickness="0,0,0,1" BorderBrush="#F1F4F8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind MedicineName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind NetQuantity}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind UnitPrice, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind PurchasePrice, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" Foreground="#4B5563"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind NetSubtotal, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="5" Text="{x:Bind Profit, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" Foreground="#047857" FontWeight="SemiBold"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock Grid.Row="2" Text="Pick a bill on the left to see its items and profit." Foreground="#8A94A6"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.SelectedBill, Mode=OneWay, Converter={StaticResource EmptyToVisibilityConverter}}"/>

                    <Grid Grid.Row="3" Padding="16,10" BorderBrush="#E5E9EF" BorderThickness="0,1,0,0" ColumnSpacing="28" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="BILL TOTAL" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedBillDetails.GrandTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="BILL PROFIT" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedBillDetails.TotalProfit, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="18" FontWeight="SemiBold" Foreground="#047857" HorizontalAlignment="Right"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
