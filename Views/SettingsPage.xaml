<Page
    x:Class="DChemist.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>
        <Style x:Key="NavButton" TargetType="ToggleButton">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Foreground" Value="#374151"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid x:Name="Root" Background="Transparent" CornerRadius="6" Padding="12,9">
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="2" Margin="-12,0,0,0"
                                    HorizontalAlignment="Left" Background="{StaticResource AccentAccent}" Visibility="Collapsed"/>
                            <ContentPresenter x:Name="Text" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"/>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#F1F5F9"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#E2E8F0"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#EEF4FB"/>
                                            <Setter Target="Pill.Visibility" Value="Visible"/>
                                            <Setter Target="Text.FontWeight" Value="SemiBold"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#E3EDF8"/>
                                            <Setter Target="Pill.Visibility" Value="Visible"/>
                                            <Setter Target="Text.FontWeight" Value="SemiBold"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="CheckedPressed">
                                        <VisualState.Setters>
                                            <Setter Target="Root.Background" Value="#E3EDF8"/>
                                            <Setter Target="Pill.Visibility" Value="Visible"/>
                                            <Setter Target="Text.FontWeight" Value="SemiBold"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Section nav ============ -->
        <Border Background="White" BorderBrush="#E5E9EF" BorderThickness="0,0,1,0" Padding="8,12">
            <StackPanel Spacing="2">
                <TextBlock Text="Settings" FontSize="20" FontWeight="SemiBold" Margin="12,0,0,10"/>
                <ToggleButton x:Name="NavPharmacy" Content="Pharmacy details" Tag="SecPharmacy" IsChecked="True" Click="OnSectionClick" Style="{StaticResource NavButton}"/>
                <ToggleButton x:Name="NavPrinter" Content="Receipt printer" Tag="SecPrinter" Click="OnSectionClick" Style="{StaticResource NavButton}"/>
                <ToggleButton x:Name="NavPreview" Content="Receipt preview" Tag="SecPreview" Click="OnSectionClick" Style="{StaticResource NavButton}"/>
                <ToggleButton x:Name="NavBackup" Content="Backup &amp; restore" Tag="SecBackup" Click="OnSectionClick" Style="{StaticResource NavButton}"/>
                <ToggleButton x:Name="NavUpdates" Content="Updates" Tag="SecUpdates" Click="OnSectionClick" Style="{StaticResource NavButton}"/>
                <ToggleButton x:Name="NavDanger" Content="Danger zone" Tag="SecDanger" Click="OnSectionClick" Style="{StaticResource NavButton}"
                              Foreground="#B91C1C" Margin="0,12,0,0" Visibility="{x:Bind ViewModel.IsAdmin}"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Column="1">
            <Grid Padding="24,20" MaxWidth="760" HorizontalAlignment="Left">

                <!-- ============ Pharmacy details ============ -->
                <StackPanel x:Name="SecPharmacy" Spacing="14">
                    <TextBlock Text="Pharmacy details" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="Printed at the top of every receipt." Foreground="#4B5563"/>
                    <!-- Live preview of the receipt header -->
                    <Border BorderBrush="#CBD5E0" BorderThickness="1" CornerRadius="6" Padding="12" MaxWidth="380" HorizontalAlignment="Left" Background="White">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.PharmacyName, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.PharmacyAddress, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
                            <TextBlock FontFamily="Cascadia Mono, Consolas" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center">
                                <Run Text="{x:Bind ViewModel.PharmacyPhone, Mode=OneWay}"/> · Lic <Run Text="{x:Bind ViewModel.PharmacyLicense, Mode=OneWay}"/> · NTN <Run Text="{x:Bind ViewModel.PharmacyNtn, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Grid ColumnSpacing="12" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBox Header="Pharmacy name" Text="{x:Bind ViewModel.PharmacyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. D. Chemist"/>
                        <TextBox Grid.Column="1" Header="Phone" Text="{x:Bind ViewModel.PharmacyPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. +92-332-8787833"/>
                        <TextBox Grid.Row="1" Grid.ColumnSpan="2" Header="Address" Text="{x:Bind ViewModel.PharmacyAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Full address"/>
                        <TextBox Grid.Row="2" Header="Drug licence no." Text="{x:Bind ViewModel.PharmacyLicense, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. 01-372-0011-134212M"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Header="NTN" Text="{x:Bind ViewModel.PharmacyNtn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="e.g. I736466-5"/>
                    </Grid>
                    <Button Content="Save details" Command="{x:Bind ViewModel.SavePharmacyDetailsCommand}" Style="{StaticResource PremiumButtonStyle}"/>
                </StackPanel>

                <!-- ============ Receipt printer ============ -->
                <StackPanel x:Name="SecPrinter" Spacing="14" Visibility="Collapsed">
                    <TextBlock Text="Receipt printer" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="The thermal printer used for bills." Foreground="#4B5563"/>
                    <ComboBox Header="Printer" ItemsSource="{x:Bind ViewModel.AvailablePrinters, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.PrinterName, Mode=TwoWay}"
                              PlaceholderText="Select thermal printer" HorizontalAlignment="Stretch"/>
                    <TextBox Header="Not in the list? Type its name exactly as in Windows Settings"
                             Text="{x:Bind ViewModel.PrinterName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <CheckBox Content="Print straight away, without the Windows print dialog" IsChecked="{x:Bind ViewModel.IsSilentPrintEnabled, Mode=TwoWay}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Save printer" Command="{x:Bind ViewModel.SavePrintingSettingsCommand}" Style="{StaticResource PremiumButtonStyle}"/>
                        <Button Content="Print test receipt" Command="{x:Bind ViewModel.TestPrintCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- ============ Receipt preview ============ -->
                <StackPanel x:Name="SecPreview" Spacing="14" Visibility="Collapsed">
                    <TextBlock Text="Receipt preview" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Text="A sample bill using your saved pharmacy details. Save changes first to see them here." Foreground="#4B5563" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <StackPanel Spacing="6">
                            <TextBlock Text="Silent print (thermal, 80mm)" FontWeight="SemiBold"/>
                            <Border BorderBrush="#CBD5E0" BorderThickness="1" Background="White" Padding="10">
                                <StackPanel x:Name="ThermalPreview" Width="320"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="6">
                            <TextBlock Text="Windows print dialog" FontWeight="SemiBold"/>
                            <Border BorderBrush="#CBD5E0" BorderThickness="1" Background="White">
                                <ContentControl x:Name="DialogPreview"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ============ Backup & restore ============ -->
                <StackPanel x:Name="SecBackup" Spacing="14" Visibility="Collapsed">
                    <TextBlock Text="Backup &amp; restore" Style="{StaticResource SectionTitle}"/>
                    <Border Background="#E7F7EF" CornerRadius="6" Padding="12,10">
                        <TextBlock Text="{x:Bind ViewModel.LastBackupText, Mode=OneWay}" Foreground="#047857" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Back up now" Command="{x:Bind ViewModel.BackupCommand}" Style="{StaticResource PremiumButtonStyle}"/>
                        <Button Content="Restore from a backup…" Command="{x:Bind ViewModel.RestoreCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                    <TextBlock Text="Restoring replaces all current data with the backup you pick." Foreground="#4B5563" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- ============ Updates ============ -->
                <StackPanel x:Name="SecUpdates" Spacing="14" Visibility="Collapsed">
                    <TextBlock Text="Updates" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Foreground="#4B5563">Version <Run Text="{x:Bind ViewModel.CurrentVersion}" FontWeight="SemiBold"/></TextBlock>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Check for updates" Command="{x:Bind ViewModel.CheckForUpdatesCommand}" Style="{StaticResource PremiumButtonStyle}"/>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsCheckingUpdates, Mode=OneWay}" Width="18" Height="18"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.UpdateStatusMessage, Mode=OneWay}" Foreground="#4B5563" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- ============ Danger zone ============ -->
                <StackPanel x:Name="SecDanger" Spacing="14" Visibility="Collapsed">
                    <TextBlock Text="Danger zone" Style="{StaticResource SectionTitle}" Foreground="#B91C1C"/>
                    <Border Background="#FDECEC" BorderBrush="#F3C4C4" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Clear all sales data" FontWeight="SemiBold"/>
                            <TextBlock Text="Deletes every bill and puts sold stock back. This cannot be undone." Foreground="#4B5563" TextWrapping="Wrap"/>
                            <TextBox Header="Type CLEAR to enable the button" Width="260" HorizontalAlignment="Left"
                                     Text="{x:Bind ViewModel.ClearConfirmText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Clear sales data" Command="{x:Bind ViewModel.ResetSalesDataCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanClearSales, Mode=OneWay}"
                                    Background="#B91C1C" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
