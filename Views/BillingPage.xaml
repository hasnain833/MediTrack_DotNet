<Page
    x:Class="DChemist.Views.BillingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DChemist.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    x:Name="PageRoot">

    <!-- Layout: cart on the left (search on top, keys hint below), totals panel on the right. -->
    <Grid Background="{ThemeResource AppBackgroundBrush}" RequestedTheme="Light" KeyDown="PageRoot_KeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Left: search + cart ============ -->
        <Grid Padding="16,12,16,12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search: accent border = this is where typing goes -->
            <Border Background="White" BorderBrush="{StaticResource AccentAccent}" BorderThickness="2" CornerRadius="8" Padding="4,2">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <AutoSuggestBox x:Name="MedicineSearchBox"
                                    PlaceholderText="Type medicine name or scan barcode, Enter adds"
                                    QueryIcon="Find" FontSize="16" BorderThickness="0"
                                    TextMemberPath="Name"
                                    Text="{x:Bind ViewModel.SearchMedicineText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    UpdateTextOnSelect="False"
                                    ItemsSource="{x:Bind ViewModel.MedicineResults, Mode=OneWay}"
                                    QuerySubmitted="MedicineSearchBox_QuerySubmitted">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding CategoryName}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Price, Converter={StaticResource CurrencyConverter}}" Foreground="#0B6E99" HorizontalAlignment="Right" FontWeight="Bold" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <ProgressRing Grid.Column="1" IsActive="{x:Bind ViewModel.IsSearching, Mode=OneWay}" Width="18" Height="18" Foreground="{StaticResource AccentAccent}"/>
                    <ToggleButton x:Name="ContinuousScanToggle" Grid.Column="2"
                                  Content="Enable Continuous Scanning" FontSize="12" Padding="10,4" VerticalAlignment="Center"
                                  IsChecked="{x:Bind ViewModel.IsContinuousScanMode, Mode=TwoWay}"
                                  Checked="ContinueusScanToggle_Checked"
                                  Unchecked="ContinueusScanToggle_Unchecked"
                                  ToolTipService.ToolTip="Scan many items in a row without touching the keyboard"/>
                </Grid>
            </Border>

            <!-- Cart -->
            <Border Grid.Row="1" Background="White" BorderBrush="#E5E9EF" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Background="#F8F9FA" Padding="14,8" BorderBrush="#E5E9EF" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="84"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="MEDICINE" FontSize="11" FontWeight="SemiBold" Foreground="#8A94A6" CharacterSpacing="60"/>
                        <TextBlock Grid.Column="1" Text="BOX" FontSize="11" FontWeight="SemiBold" Foreground="#8A94A6" CharacterSpacing="60" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="TABS" FontSize="11" FontWeight="SemiBold" Foreground="#8A94A6" CharacterSpacing="60" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="PRICE / TAB" FontSize="11" FontWeight="SemiBold" Foreground="#8A94A6" CharacterSpacing="60" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Column="4" Text="AMOUNT" FontSize="11" FontWeight="SemiBold" Foreground="#8A94A6" CharacterSpacing="60" HorizontalAlignment="Right"/>
                    </Grid>

                    <ListView x:Name="CartListView" Grid.Row="1" ItemsSource="{x:Bind ViewModel.CartItems, Mode=OneWay}" SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SaleItemViewModel">
                                <Grid Padding="14,6" BorderThickness="0,0,0,1" BorderBrush="#F1F4F8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="84"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind MedicineName}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind StockHint}" FontSize="11" Foreground="#8A94A6"/>
                                    </StackPanel>
                                    <TextBox x:Name="BoxInput" Grid.Column="1" Margin="6,0"
                                             Text="{Binding QuantityBoxText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Box" TextAlignment="Center" VerticalAlignment="Center"
                                             KeyDown="OnRowInputKeyDown"/>
                                    <TextBox x:Name="TabletInput" Grid.Column="2" Margin="6,0"
                                             Text="{Binding QuantityTabletText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Tab" TextAlignment="Center" VerticalAlignment="Center"
                                             KeyDown="OnRowInputKeyDown"/>
                                    <TextBlock Grid.Column="3" Text="{Binding UnitPrice, Converter={StaticResource CurrencyConverter}}"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="4" Text="{Binding Subtotal, Converter={StaticResource CurrencyConverter}}"
                                               FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <Button Grid.Column="5"
                                            Command="{Binding ViewModel.RemoveFromCartCommand, ElementName=PageRoot}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource TextBlockButtonStyle}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            ToolTipService.ToolTip="Remove line (Ctrl+Del)">
                                        <FontIcon Glyph="&#xE711;" FontSize="12" Foreground="#8A94A6"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty cart -->
                    <TextBlock Grid.Row="1" Text="Search a medicine above and press Enter to start the bill."
                               Foreground="#8A94A6" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{x:Bind ViewModel.CartItems.Count, Mode=OneWay, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- Keyboard hints -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="18">
                <TextBlock FontSize="12" Foreground="#8A94A6"><Run Text="Enter" FontWeight="SemiBold"/> add / next box</TextBlock>
                <TextBlock FontSize="12" Foreground="#8A94A6">Press <Run Text="Enter" FontWeight="SemiBold"/> to move through Discount, Cash, Name, Phone; Enter on Phone prints the bill</TextBlock>
            </StackPanel>
        </Grid>

        <!-- ============ Right: totals panel ============ -->
        <Border Grid.Column="1" Background="White" BorderBrush="#E5E9EF" BorderThickness="1,0,0,0">
            <Grid Padding="16" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Grand total, readable across the counter -->
                <Border Background="{StaticResource PremiumBackgroundBrush}" CornerRadius="8" Padding="16,12">
                    <StackPanel Spacing="2">
                        <TextBlock Text="GRAND TOTAL" FontSize="11" Foreground="#A7B0C0" CharacterSpacing="80"/>
                        <TextBlock Text="{x:Bind ViewModel.GrandTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentAccent}"/>
                        <TextBlock Text="{x:Bind ViewModel.ItemCountText, Mode=OneWay}" FontSize="12" Foreground="#A7B0C0"/>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock Text="Subtotal" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.TotalAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Visibility="{x:Bind ViewModel.TaxAmount, Mode=OneWay, Converter={StaticResource DecimalToVisibilityConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.TaxRateText, Mode=OneWay}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.TaxAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Discount (Rs)" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="DiscountBox" KeyDown="OnEnterNext" Text="{x:Bind ViewModel.DiscountText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="0" Width="96" HorizontalAlignment="Right" TextAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Discount" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.DiscountAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right"/>
                        </Grid>

                        <Border Height="1" Background="#E5E9EF" Margin="0,4"/>

                        <Grid>
                            <TextBlock Text="Cash received" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBox x:Name="CashBox" KeyDown="OnEnterNext" Text="{x:Bind ViewModel.CashReceivedText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="0" Width="96" HorizontalAlignment="Right" TextAlignment="Right"/>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Change to return" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Text="{x:Bind ViewModel.ChangeText, Mode=OneWay}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Right"
                                       Foreground="{x:Bind ViewModel.IsChangeOk, Mode=OneWay, Converter={StaticResource StatusFgConverter}}"/>
                        </Grid>

                        <Expander x:Name="CustomerExpander" Header="Customer (optional)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="8">
                                <TextBox x:Name="CustomerNameBox" KeyDown="OnEnterNext" Header="Name" Text="{x:Bind ViewModel.CustomerName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Walk-in customer"/>
                                <TextBox x:Name="CustomerPhoneBox" KeyDown="OnPrintKeyDown" Header="Phone" Text="{x:Bind ViewModel.CustomerPhone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="03xx-xxxxxxx"/>
                            </StackPanel>
                        </Expander>

                        <!-- Stock / error feedback — hidden when empty -->
                        <Border Background="{x:Bind ViewModel.IsStatusSuccess, Mode=OneWay, Converter={StaticResource StatusBgConverter}}"
                                CornerRadius="6" Padding="10,8"
                                Visibility="{x:Bind ViewModel.StatusMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{x:Bind ViewModel.IsStatusSuccess, Mode=OneWay, Converter={StaticResource StatusFgConverter}}"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Spacing="8">
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20" Foreground="{StaticResource AccentAccent}"/>
                    <Button Command="{x:Bind ViewModel.CompleteSaleReportedCommand}" Style="{StaticResource PremiumButtonStyle}"
                            HorizontalAlignment="Stretch" Height="46" FontSize="15" FontWeight="Bold" Content="Print bill"/>
                    <Button Command="{x:Bind ViewModel.CompleteSaleInternalCommand}" Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch" Height="38" Content="Save without printing"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Hidden Barcode Receiver for continuous scanning -->
        <TextBox x:Name="BarcodeReceiver"
                 Width="0" Height="0" Opacity="0"
                 Text="{x:Bind ViewModel.BarcodeText, Mode=TwoWay}"
                 KeyDown="HiddenBarcodeReceiver_KeyDown"/>
    </Grid>
</Page>
