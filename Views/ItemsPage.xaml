<Page
    x:Class="DChemist.Views.ItemsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DChemist.Models"
    xmlns:utils="using:DChemist.Utils"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}" RequestedTheme="Light"
    x:Name="PageRoot">

    <Page.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <utils:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <utils:CurrencyConverter x:Key="CurrencyConverter"/>
        <utils:EditModeToTitleConverter x:Key="EditModeToTitleConverter"/>
        <utils:EditModeToButtonTextConverter x:Key="EditModeToButtonTextConverter"/>
        <utils:BooleanToGridLengthConverter x:Key="DrawerWidthConverter" TrueLength="380" FalseLength="0"/>

        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A94A6"/>
            <Setter Property="CharacterSpacing" Value="60"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SectionHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A94A6"/>
            <Setter Property="CharacterSpacing" Value="80"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Toolbar ============ -->
        <Border Background="White" BorderBrush="#E5E9EF" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Items" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <AutoSuggestBox x:Name="ListSearchBox" Grid.Column="1" MaxWidth="460" HorizontalAlignment="Left"
                                PlaceholderText="Search name, generic or barcode, Enter opens it"
                                QuerySubmitted="OnListSearchSubmitted" QueryIcon="Find"
                                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ToggleButton x:Name="FilterAll" Content="All" Tag="all" IsChecked="True" Click="OnFilterClick" Style="{StaticResource Chip}"/>
                    <ToggleButton x:Name="FilterLow" Content="Low stock" Tag="low" Click="OnFilterClick" Style="{StaticResource Chip}"/>
                    <ToggleButton x:Name="FilterExp" Content="Expiring" Tag="exp" Click="OnFilterClick" Style="{StaticResource Chip}"/>
                    <ToggleButton x:Name="FilterNet" Content="Net items" Tag="net" Click="OnFilterClick" Style="{StaticResource Chip}"/>
                </StackPanel>
                <Button x:Name="ExportExpiryButton" Grid.Column="3" Click="OnExportExpiryClick" Style="{StaticResource SecondaryButtonStyle}"
                        Content="Export for supplier" Visibility="Collapsed" ToolTipService.ToolTip="Print / save as PDF the expiring stock of one supplier"/>
                <Button Grid.Column="4" Click="OnNewClick" Style="{StaticResource PremiumButtonStyle}" Content="+ New medicine"/>
            </Grid>
        </Border>

        <!-- ============ Table + drawer ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="{x:Bind ViewModel.IsFormExpanded, Mode=OneWay, Converter={StaticResource DrawerWidthConverter}}"/>
            </Grid.ColumnDefinitions>

            <!-- Table -->
            <Grid Background="White">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Background="#F8F9FA" Padding="16,8" BorderBrush="#E5E9EF" BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="MEDICINE" Style="{StaticResource ColHead}"/>
                    <TextBlock Grid.Column="1" Text="BATCH · SUPPLIER" Style="{StaticResource ColHead}"/>
                    <TextBlock Grid.Column="2" Text="EXPIRY" Style="{StaticResource ColHead}"/>
                    <TextBlock Grid.Column="3" Text="IN STOCK" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="4" Text="COST / TAB" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="5" Text="PRICE / TAB" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                    <TextBlock Grid.Column="6" Text="MARGIN" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                </Grid>

                <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Medicines, Mode=OneWay}"
                          SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="MinHeight" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:Medicine">
                            <Grid Padding="16,7" BorderThickness="0,0,0,1" BorderBrush="#F1F4F8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <Border Background="#FEF3C7" CornerRadius="4" Padding="5,0" VerticalAlignment="Center" Visibility="{x:Bind IsNet}">
                                            <TextBlock Text="NET" FontSize="10" FontWeight="Bold" Foreground="#92400E"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontSize="11" Foreground="#8A94A6" TextTrimming="CharacterEllipsis">
                                        <Run Text="{x:Bind GenericName}"/> <Run Text="{x:Bind CategoryName, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind BatchNo, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                                    <TextBlock Text="{x:Bind SupplierName}" FontSize="11" Foreground="#8A94A6" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="#B45309" Visibility="{Binding ExpiryDate, Converter={StaticResource NearExpiryToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding ExpiryDate, Converter={StaticResource DateFormatConverter}, ConverterParameter='MM/yy'}"
                                               Foreground="{Binding ExpiryDate, Converter={StaticResource ExpiryToColorConverter}}" FontWeight="SemiBold"/>
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="{x:Bind FormattedQuantity}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="{x:Bind StockQty, Converter={StaticResource StockLevelColorConverter}}"/>

                                <TextBlock Grid.Column="4" Text="{x:Bind FormattedPurchasePrice, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="#4B5563" Tapped="OnPurchasePriceTapped" ToolTipService.ToolTip="Click to show / hide cost"/>
                                <TextBlock Grid.Column="5" Text="{x:Bind SellingPrice, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontWeight="SemiBold" Foreground="#0B6E99"/>
                                <TextBlock Grid.Column="6" Text="{x:Bind MarginText, Mode=OneWay}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Foreground="#047857" FontWeight="SemiBold"/>

                                <Button Grid.Column="7" Click="OnDeleteClick" Tag="{Binding}" Style="{StaticResource TextBlockButtonStyle}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" ToolTipService.ToolTip="Delete medicine">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#B91C1C"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="1" Text="No medicines match. Ctrl+N adds a new one." Foreground="#8A94A6"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{x:Bind ViewModel.Medicines.Count, Mode=OneWay, Converter={StaticResource EmptyToVisibilityConverter}}"/>

                <Border Grid.Row="2" Background="#F8F9FA" BorderBrush="#E5E9EF" BorderThickness="0,1,0,0" Padding="16,6">
                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <TextBlock FontSize="12" Foreground="#8A94A6">Search and press <Run Text="Enter" FontWeight="SemiBold"/> to open a medicine · <Run Text="Enter" FontWeight="SemiBold"/> moves through the form and saves on the last field · click a cost to reveal it</TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ============ Drawer: add / edit form ============ -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E5E9EF" BorderThickness="1,0,0,0"
                    Visibility="{x:Bind ViewModel.IsFormExpanded, Mode=OneWay}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Padding="16,10" BorderBrush="#E5E9EF" BorderThickness="0,0,0,1">
                        <TextBlock Text="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource EditModeToTitleConverter}}"
                                   FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Click="OnCloseFormClick" Style="{StaticResource SecondaryButtonStyle}" Content="Close"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="16,8,16,16" Spacing="8">
                            <TextBlock Text="MEDICINE" Style="{StaticResource SectionHead}"/>
                            <TextBox x:Name="BarcodeBox" Header="Barcode"
                                     Text="{x:Bind ViewModel.BarcodeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnBarcodeKeyDown" PlaceholderText="Scan or type"/>
                            <TextBox x:Name="MedicineNameBox" Header="Name"
                                     Text="{x:Bind ViewModel.EntryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     KeyDown="OnInputKeyDown"/>
                            <TextBox x:Name="CategoryBox" Header="Category"
                                     Text="{x:Bind ViewModel.EditCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="e.g. Antibiotic" KeyDown="OnInputKeyDown"/>
                            <CheckBox x:Name="NetCheckBox" KeyDown="OnInputKeyDown"
                                      Content="Net item (actual paid price differs from invoice price)"
                                      IsChecked="{x:Bind ViewModel.IsNetItem, Mode=TwoWay}"/>

                            <TextBlock Text="PACKAGING" Style="{StaticResource SectionHead}"/>
                            <Grid ColumnSpacing="4" HorizontalAlignment="Left" Width="200">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <ToggleButton Content="Box" x:Name="BoxModeBtn" HorizontalAlignment="Stretch"
                                              IsChecked="{x:Bind ViewModel.IsBoxMode, Mode=OneWay}"
                                              Click="OnModeChanged" PreviewKeyDown="OnModeKeyDown" Style="{StaticResource SegmentedButtonStyle}"/>
                                <ToggleButton Grid.Column="1" Content="Tablet" x:Name="TabletModeBtn" HorizontalAlignment="Stretch"
                                              IsChecked="{x:Bind ViewModel.IsTabletMode, Mode=OneWay}"
                                              Click="OnModeChanged" PreviewKeyDown="OnModeKeyDown" Style="{StaticResource SegmentedButtonStyle}"/>
                            </Grid>
                            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsBoxMode, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Packs / box" x:Name="PacketsPerBoxBox"
                                         Text="{x:Bind ViewModel.PacketsPerBoxText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="e.g. 10" KeyDown="OnInputKeyDown"/>
                                <TextBox Grid.Column="1" Header="Tabs / pack" x:Name="UnitsPerPacketBox"
                                         Text="{x:Bind ViewModel.UnitsPerPacketText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="e.g. 10" KeyDown="OnInputKeyDown"/>
                            </Grid>

                            <TextBlock Text="STOCK &amp; PRICE" Style="{StaticResource SectionHead}"/>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BatchNumberBox" Header="Batch"
                                         Text="{x:Bind ViewModel.BatchNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OnInputKeyDown"/>
                                <TextBox x:Name="ExpiryDateBox" Grid.Column="1" Header="Expiry"
                                         Text="{x:Bind ViewModel.ExpiryDateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="MM/YY" KeyDown="OnInputKeyDown" LostFocus="ExpiryDateBox_LostFocus"/>
                            </Grid>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBox Header="No. of boxes" x:Name="PackQuantityBox"
                                         Visibility="{x:Bind ViewModel.IsBoxMode, Mode=OneWay}"
                                         Text="{x:Bind ViewModel.PackQuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         PlaceholderText="e.g. 10" KeyDown="OnInputKeyDown"/>
                                <TextBox Header="Quantity (tabs)" x:Name="QuantityBox"
                                         Visibility="{x:Bind ViewModel.IsTabletMode, Mode=OneWay}"
                                         Text="{x:Bind ViewModel.QuantityUnitsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OnInputKeyDown"/>
                                <TextBox Grid.Column="1" x:Name="SellingPriceBox" Header="Selling price"
                                         Text="{x:Bind ViewModel.SellingPriceText, Mode=TwoWay}"
                                         PlaceholderText="0.00" KeyDown="OnInputKeyDown"/>
                            </Grid>
                            <TextBlock Text="{x:Bind ViewModel.TotalUnitsPreviewText, Mode=OneWay}" FontSize="12" Foreground="#0B6E99"
                                       Visibility="{x:Bind ViewModel.IsBoxMode, Mode=OneWay}"/>

                            <!-- Corrections that only make sense for an existing medicine -->
                            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <TextBox Header="Cost / tab" Text="{x:Bind ViewModel.EditPurchasePriceText, Mode=TwoWay}" PlaceholderText="0.00"/>
                                <TextBox Grid.Column="1" Header="Stock (tabs)" Text="{x:Bind ViewModel.EditStockQtyText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" TextWrapping="Wrap" FontSize="12" Foreground="#4B5563"/>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Padding="16,10" BorderBrush="#E5E9EF" BorderThickness="0,1,0,0">
                        <TextBlock Text="Enter → next field" FontSize="12" Foreground="#8A94A6" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Click="OnSaveClick" Style="{StaticResource PremiumButtonStyle}">
                            <TextBlock>
                                <Run Text="{x:Bind ViewModel.IsEditMode, Mode=OneWay, Converter={StaticResource EditModeToButtonTextConverter}}"/>
                            </TextBlock>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Grid.RowSpan="2" Width="48" Height="48"
                      Foreground="{StaticResource AccentAccent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Page>
