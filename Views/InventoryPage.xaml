<Page
    x:Class="DChemist.Views.InventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:vm="using:DChemist.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DChemist.Models"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    mc:Ignorable="d"
    x:Name="PageRoot">

    <Grid Background="{ThemeResource AppBackgroundBrush}" RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Banner -->
        <Border Background="{StaticResource PremiumBackgroundBrush}"
                CornerRadius="0,0,24,24" Padding="40,32" Margin="0,0,0,24">
            <StackPanel Spacing="10" Margin="60,0,0,16">
                <TextBlock Text="Inventory" FontSize="32" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Manage your medicines, stock levels and pricing." FontSize="15" Foreground="#A0AEC0"/>
            </StackPanel>
        </Border>

        <!-- Main content wrapped in ScrollViewer -->
        <ScrollViewer Grid.Row="1" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Error Banner — hidden when empty -->
                <Border Grid.Row="0" Background="#FFF3F3" CornerRadius="8" Padding="12,10"
                        Margin="24,16,24,0"
                        Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE783;" FontSize="16" Foreground="#C0392B" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                   Foreground="#C0392B" FontWeight="SemiBold" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Search and Add Header -->
                <Border Grid.Row="1" Style="{StaticResource PremiumCardStyle}" Padding="24,16" Margin="40,16,40,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <AutoSuggestBox PlaceholderText="Search inventory..." 
                                            Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            TextMemberPath="Name"
                                            QueryIcon="Find" Width="500" Height="40" VerticalAlignment="Center"/>
                            
                            <Button Command="{x:Bind ViewModel.RefreshCommand}" 
                                    Style="{StaticResource TextBlockButtonStyle}" Padding="12,8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Refresh" FontSize="14" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{x:Bind ViewModel.ExportCommand}" 
                                    Style="{StaticResource TextBlockButtonStyle}" Padding="12,8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Export CSV" FontSize="14" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{x:Bind ViewModel.DeleteSelectedCommand}"
                                Background="#E53E3E" Foreground="White" BorderBrush="Transparent"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                CornerRadius="8" Padding="20,10"
                                Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74D;" FontSize="16"/>
                                <TextBlock Text="Delete Selected" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Inventory Table -->
                <Border Grid.Row="2" Style="{StaticResource PremiumCardStyle}" Padding="0" Margin="40,0,40,40">
                    <Grid>
                        <controls:DataGrid AutoGenerateColumns="False"
                                       ItemsSource="{x:Bind ViewModel.Medicines, Mode=OneWay}"
                                       IsReadOnly="True"
                                       GridLinesVisibility="Horizontal"
                                       HeadersVisibility="Column"
                                       Background="Transparent"
                                       RowHeight="56">
                        <controls:DataGrid.Resources>
                            <SolidColorBrush x:Key="DataGridRowSelectedBackgroundBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="DataGridRowSelectedHoveredBackgroundBrush" Color="Transparent"/>
                            <SolidColorBrush x:Key="DataGridRowHoveredBackgroundBrush" Color="#F9FAFB"/>
                            <SolidColorBrush x:Key="DataGridRowSelectedForegroundBrush" Color="{StaticResource TextPrimaryBrush}"/>
                            <SolidColorBrush x:Key="DataGridColumnHeaderBackgroundBrush" Color="#F9FAFB"/>
                            <SolidColorBrush x:Key="DataGridColumnHeaderPointerOverBackgroundBrush" Color="#F9FAFB"/>
                            <SolidColorBrush x:Key="DataGridColumnHeaderPressedBackgroundBrush" Color="#F9FAFB"/>
                        </controls:DataGrid.Resources>
                        <controls:DataGrid.Columns>

                            <!-- Checkbox -->
                            <controls:DataGridTemplateColumn Width="50">
                                <controls:DataGridTemplateColumn.HeaderStyle>
                                    <Style TargetType="primitives:DataGridColumnHeader">
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding ViewModel.IsAllSelected, ElementName=PageRoot, Mode=TwoWay}"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Margin="0" MinWidth="0"/>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </controls:DataGridTemplateColumn.HeaderStyle>
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Medicine">
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="0" MinWidth="0"/>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <!-- Medicine Name + Generic Name -->
                            <controls:DataGridTemplateColumn Header="Medicine" Width="2.5*" Tag="Name">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Medicine">
                                        <StackPanel VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind GenericName}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Visibility="{x:Bind GenericName, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Inverse'}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <!-- Category + Dosage Form -->
                            <controls:DataGridTemplateColumn Header="Category" Width="1.5*">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Medicine">
                                        <StackPanel VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{x:Bind CategoryName}" FontSize="12"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind FormattedDosage}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <!-- Batch + Supplier -->
                            <controls:DataGridTemplateColumn Header="Batch / Supplier" Width="1.5*">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Medicine">
                                        <StackPanel VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{x:Bind BatchNo}" FontSize="12"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind SupplierName}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <!-- Stock Qty with low-stock indicator -->
                            <controls:DataGridTemplateColumn Header="Stock" Width="90">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Medicine">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Margin="8,0" Spacing="6">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                     Fill="{x:Bind StockQty, Converter={StaticResource StockLevelColorConverter}}"/>
                                            <TextBlock Text="{x:Bind StockQty}" FontSize="14" FontWeight="SemiBold"
                                                       Foreground="{x:Bind StockQty, Converter={StaticResource StockLevelColorConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <!-- Selling Price -->
                            <controls:DataGridTemplateColumn Header="Sell Price" Width="110">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Medicine">
                                        <TextBlock Text="{x:Bind SellingPrice, Converter={StaticResource CurrencyConverter}}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentAccent}"
                                                   VerticalAlignment="Center" Margin="8,0"/>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <!-- Purchase Price (Admin toggle) -->
                            <controls:DataGridTemplateColumn Header="Buy Price" Width="110"
                                                             Visibility="{Binding ViewModel.IsAdmin, ElementName=PageRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Medicine">
                                        <Button Click="OnTogglePurchasePriceClick"
                                                Style="{StaticResource TextBlockButtonStyle}"
                                                Padding="8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FormattedPurchasePrice, Mode=OneWay}"
                                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <!-- Expiry Date -->
                            <controls:DataGridTemplateColumn Header="Expiry" Width="130">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Medicine">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="8,0"
                                                    VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="#D97706"
                                                      Visibility="{Binding ExpiryDate, Converter={StaticResource NearExpiryToVisibilityConverter}}"
                                                      VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ExpiryDate, Converter={StaticResource DateFormatConverter}, ConverterParameter='MMM yyyy'}"
                                                       Foreground="{Binding ExpiryDate, Converter={StaticResource ExpiryToColorConverter}}"
                                                       VerticalAlignment="Center" FontSize="13"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </controls:DataGridTemplateColumn.CellTemplate>
                            </controls:DataGridTemplateColumn>

                            <!-- GST % -->
                            <controls:DataGridTemplateColumn Header="GST" Width="70">
                                <controls:DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="models:Medicine">
                                        <TextBlock Text="{x:Bind FormattedGst}"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" Margin="8,0"/>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>

                                <!-- Actions -->
                                <controls:DataGridTemplateColumn Header="Actions" Width="100">
                                    <controls:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="models:Medicine">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                                <Button x:Name="EditMedicineButton" Click="OnEditMedicineClick"
                                                        Style="{StaticResource TextBlockButtonStyle}" Padding="8">
                                                    <ToolTipService.ToolTip>
                                                        <ToolTip Content="Edit Medicine"/>
                                                    </ToolTipService.ToolTip>
                                                    <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="{StaticResource AccentAccent}"/>
                                                </Button>
                                                <Button x:Name="DeleteMedicineButton" Click="OnDeleteMedicineClick"
                                                        Style="{StaticResource TextBlockButtonStyle}" Padding="8">
                                                    <ToolTipService.ToolTip>
                                                        <ToolTip Content="Delete Medicine"/>
                                                    </ToolTipService.ToolTip>
                                                    <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="#E53E3E"/>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </controls:DataGridTemplateColumn.CellTemplate>
                                </controls:DataGridTemplateColumn>

                            </controls:DataGrid.Columns>
                        </controls:DataGrid>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"
                                      Foreground="{StaticResource AccentAccent}" Width="40" Height="40"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
