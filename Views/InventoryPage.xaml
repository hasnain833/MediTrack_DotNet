<Page
    x:Class="DChemist.Views.InventoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:vm="using:DChemist.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DChemist.Models"
    xmlns:primitives="using:CommunityToolkit.WinUI.UI.Controls.Primitives"
    mc:Ignorable="d"
    x:Name="PageRoot">

    <Grid Background="{ThemeResource AppBackgroundBrush}" RequestedTheme="Light">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Banner -->
        <Border Background="{StaticResource PremiumBackgroundBrush}"
                CornerRadius="0,0,24,24" Padding="40,32" Margin="0,0,0,24">
            <StackPanel Spacing="10" Margin="60,0,0,16">
                <TextBlock Text="Inventory" FontSize="32" FontWeight="SemiBold" Foreground="White"/>
                <TextBlock Text="Manage your medicines, stock levels and pricing." FontSize="15" Foreground="#A0AEC0"/>
            </StackPanel>
        </Border>

        <!-- Main content wrapped in ScrollViewer -->
        <ScrollViewer Grid.Row="1" Grid.RowSpan="3" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Error Banner — hidden when empty -->
                <Border Grid.Row="0" Background="#FFF3F3" CornerRadius="8" Padding="12,10"
                        Margin="24,16,24,0"
                        Visibility="{x:Bind ViewModel.ErrorMessage, Mode=OneWay, Converter={StaticResource StringToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE783;" FontSize="16" Foreground="#C0392B" VerticalAlignment="Center"/>
                        <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                                   Foreground="#C0392B" FontWeight="SemiBold" TextWrapping="Wrap"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Search and Add Header -->
                <Border Grid.Row="1" Style="{StaticResource PremiumCardStyle}" Padding="24,16" Margin="40,16,40,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <AutoSuggestBox PlaceholderText="Search inventory..." 
                                             Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextMemberPath="Name"
                                             QueryIcon="Find" Width="500" Height="40" VerticalAlignment="Center"/>
                            
                            <Button Command="{x:Bind ViewModel.RefreshCommand}" 
                                    Style="{StaticResource TextBlockButtonStyle}" Padding="12,8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Refresh" FontSize="14" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{x:Bind ViewModel.ExportCommand}" 
                                    Style="{StaticResource TextBlockButtonStyle}" Padding="12,8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE896;" FontSize="16" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBlock Text="Export CSV" FontSize="14" VerticalAlignment="Center" FontWeight="Medium"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{x:Bind ViewModel.DeleteSelectedCommand}"
                                 Background="#E53E3E" Foreground="White" BorderBrush="Transparent"
                                 HorizontalAlignment="Right" VerticalAlignment="Center"
                                 CornerRadius="8" Padding="20,10"
                                 Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE74D;" FontSize="16"/>
                                <TextBlock Text="Delete Selected" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- Inventory Table -->
                <Border Grid.Row="2" Style="{StaticResource PremiumCardStyle}" Padding="0" Margin="40,0,40,40" MinHeight="400">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Table Header -->
                        <Grid Background="#F9FAFB" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="2.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <CheckBox IsChecked="{x:Bind ViewModel.IsAllSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0"/>
                            <TextBlock Grid.Column="1" Text="Medicine" FontWeight="Bold" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="2" Text="Category" FontWeight="Bold" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="3" Text="Batch/Supplier" FontWeight="Bold" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="4" Text="Stock" FontWeight="Bold" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="5" Text="Sell Price" FontWeight="Bold" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="6" Text="Buy Price" FontWeight="Bold" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" Margin="8,0" Visibility="{x:Bind ViewModel.IsAdmin, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <TextBlock Grid.Column="7" Text="Expiry" FontWeight="Bold" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="8" Text="GST" FontWeight="Bold" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" Margin="8,0"/>
                            <TextBlock Grid.Column="9" Text="Actions" FontWeight="Bold" FontSize="12" Foreground="#4A5568" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>

                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Medicines, Mode=OneWay}" SelectionMode="None" Padding="0" Background="Transparent">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Medicine">
                                    <Grid Padding="16,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="2.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="130"/>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="100"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="0"/>
                                        
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind GenericName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind GenericName, Converter={StaticResource NullToVisibilityConverter}, ConverterParameter='Inverse'}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{x:Bind CategoryName}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind FormattedDosage}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{x:Bind BatchNo}" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind SupplierName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0" Spacing="6">
                                            <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind StockQty, Converter={StaticResource StockLevelColorConverter}}"/>
                                            <TextBlock Text="{x:Bind StockQty}" FontSize="14" FontWeight="SemiBold" Foreground="{x:Bind StockQty, Converter={StaticResource StockLevelColorConverter}}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="5" Text="{x:Bind SellingPrice, Converter={StaticResource CurrencyConverter}}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentAccent}" VerticalAlignment="Center" Margin="8,0"/>

                                        <Button Grid.Column="6" Click="OnTogglePurchasePriceClick" Style="{StaticResource TextBlockButtonStyle}" Padding="8,0" VerticalAlignment="Center" Visibility="{Binding ViewModel.IsAdmin, ElementName=PageRoot, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind FormattedPurchasePrice, Mode=OneWay}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                        </Button>

                                        <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="6" Margin="8,0" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE7BA;" FontSize="13" Foreground="#D97706" Visibility="{Binding ExpiryDate, Converter={StaticResource NearExpiryToVisibilityConverter}}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ExpiryDate, Converter={StaticResource DateFormatConverter}, ConverterParameter='MMM yyyy'}" Foreground="{Binding ExpiryDate, Converter={StaticResource ExpiryToColorConverter}}" VerticalAlignment="Center" FontSize="13"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="8" Text="{x:Bind FormattedGst}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0"/>

                                        <StackPanel Grid.Column="9" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                            <Button Click="OnEditMedicineClick" Style="{StaticResource TextBlockButtonStyle}" Padding="8">
                                                <FontIcon Glyph="&#xE70F;" FontSize="16" Foreground="{StaticResource AccentAccent}"/>
                                            </Button>
                                            <Button Click="OnDeleteMedicineClick" Style="{StaticResource TextBlockButtonStyle}" Padding="8">
                                                <FontIcon Glyph="&#xE74D;" FontSize="16" Foreground="#E53E3E"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Foreground="{StaticResource AccentAccent}" Width="40" Height="40"/>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
