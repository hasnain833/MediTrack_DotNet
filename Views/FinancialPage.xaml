<Page
    x:Class="DChemist.Views.FinancialPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DChemist.ViewModels"
    xmlns:repo="using:DChemist.Repositories"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>
        <CollectionViewSource x:Name="BillsSource" Source="{x:Bind ViewModel.BillGroups, Mode=OneWay}" IsSourceGrouped="True"/>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A94A6"/>
            <Setter Property="CharacterSpacing" Value="60"/>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Toolbar ============ -->
        <Border Background="White" BorderBrush="#E5E9EF" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Bills" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" MaxWidth="380" HorizontalAlignment="Left"
                         PlaceholderText="Search bill no., customer or phone"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ToggleButton x:Name="RangeToday" Content="Today" Tag="today" IsChecked="True" Click="OnRangeClick" Style="{StaticResource Chip}"/>
                    <ToggleButton x:Name="RangeYesterday" Content="Yesterday" Tag="yesterday" Click="OnRangeClick" Style="{StaticResource Chip}"/>
                    <ToggleButton x:Name="RangeWeek" Content="7 days" Tag="week" Click="OnRangeClick" Style="{StaticResource Chip}"/>
                    <ToggleButton x:Name="RangeAll" Content="All" Tag="all" Click="OnRangeClick" Style="{StaticResource Chip}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="20" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="BILLS" Style="{StaticResource ColHead}"/>
                        <TextBlock Text="{x:Bind ViewModel.BillCount, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="NET SALES" Style="{StaticResource ColHead}"/>
                        <TextBlock Text="{x:Bind ViewModel.BillsTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Bill list, grouped by day ============ -->
            <Border Background="White" BorderBrush="#E5E9EF" BorderThickness="0,0,1,0">
                <Grid>
                    <ListView x:Name="BillList" ItemsSource="{x:Bind BillsSource.View, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedSale, Mode=TwoWay}" SelectionMode="Single">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="vm:BillGroup">
                                        <Grid>
                                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource ColHead}"/>
                                            <TextBlock Text="{x:Bind Total, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.HeaderContainerStyle>
                                    <Style TargetType="ListViewHeaderItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="#F8F9FA"/>
                                        <Setter Property="Padding" Value="14,6"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>
                                </GroupStyle.HeaderContainerStyle>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="repo:SaleSummary">
                                <Grid Padding="14,8" BorderThickness="0,0,0,1" BorderBrush="#F1F4F8" RowSpacing="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind BillNo}" FontFamily="Cascadia Mono, Consolas" FontSize="13" FontWeight="SemiBold"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="1" Text="{x:Bind Customer}" FontSize="12" Foreground="#4B5563" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <TextBlock Text="{x:Bind TimeText}" FontSize="11" Foreground="#8A94A6" VerticalAlignment="Center"/>
                                        <Border Background="{x:Bind Status, Converter={StaticResource StatusToBackgroundConverter}}" CornerRadius="8" Padding="7,0">
                                            <TextBlock Text="{x:Bind Status}" FontSize="11" FontWeight="SemiBold" Foreground="{x:Bind Status, Converter={StaticResource StatusToForegroundConverter}}"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#8A94A6" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                               Visibility="{x:Bind ViewModel.BillCount, Mode=OneWay, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- ============ Bill detail, reads like the printed bill ============ -->
            <Grid Grid.Column="1" Padding="16" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="White" BorderBrush="#E5E9EF" BorderThickness="1" CornerRadius="8"
                        Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Padding="16,12" BorderBrush="#E5E9EF" BorderThickness="0,0,0,1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedSale.BillNo, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="19" FontWeight="SemiBold"/>
                                    <Border Background="{x:Bind ViewModel.SelectedSale.Status, Mode=OneWay, Converter={StaticResource StatusToBackgroundConverter}}" CornerRadius="8" Padding="8,1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedSale.Status, Mode=OneWay}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{x:Bind ViewModel.SelectedSale.Status, Mode=OneWay, Converter={StaticResource StatusToForegroundConverter}}"/>
                                    </Border>
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsDetailsLoading, Mode=OneWay}" Width="16" Height="16"/>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ViewModel.DetailFacts, Mode=OneWay}" FontSize="13" Foreground="#4B5563"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.IsNotReturnMode, Mode=OneWay}">
                                <Button Command="{x:Bind ViewModel.ReprintReceiptCommand}" Style="{StaticResource PremiumButtonStyle}" Content="Reprint"/>
                                <Button Command="{x:Bind ViewModel.StartReturnCommand}" Style="{StaticResource SecondaryButtonStyle}" Foreground="#B45309" Content="Return items"/>
                                <Button Command="{x:Bind ViewModel.VoidSaleCommand}" Style="{StaticResource SecondaryButtonStyle}" Foreground="#B91C1C" Content="Void"/>
                            </StackPanel>
                        </Grid>

                        <!-- Return mode banner -->
                        <Border Grid.Row="1" Background="#FFF6E5" BorderBrush="#F8D899" BorderThickness="0,0,0,1" Padding="16,8"
                                Visibility="{x:Bind ViewModel.IsReturnMode, Mode=OneWay}">
                            <TextBlock Foreground="#B45309" FontSize="13">↩ Return mode: type how many units come back, then confirm. Esc cancels.</TextBlock>
                        </Border>

                        <!-- Column headers -->
                        <Grid Grid.Row="2" Background="#F8F9FA" Padding="16,8" BorderBrush="#E5E9EF" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MEDICINE" Style="{StaticResource ColHead}"/>
                            <TextBlock Grid.Column="1" Text="QTY" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="2" Text="PRICE" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="AMOUNT" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="4" Text="RETURN" Style="{StaticResource ColHead}" Width="86" TextAlignment="Right"
                                       Visibility="{x:Bind ViewModel.IsReturnMode, Mode=OneWay}"/>
                        </Grid>

                        <ListView Grid.Row="3" ItemsSource="{x:Bind ViewModel.SelectedInvoiceItems, Mode=OneWay}" SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="MinHeight" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:InvoiceItemViewModel">
                                    <Grid Padding="16,8" BorderThickness="0,0,0,1" BorderBrush="#F1F4F8" Opacity="{x:Bind RowOpacity}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="110"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind MedicineName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Run Text="{x:Bind RemainingQuantity}"/> <Run Text="{x:Bind ReturnedText}" Foreground="#B91C1C" FontSize="12"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{x:Bind UnitPrice, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#4B5563"/>
                                        <TextBlock Grid.Column="3" Text="{x:Bind CurrentTotal, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
                                        <TextBox Grid.Column="4" x:Name="ReturnQtyBox" Width="70" Margin="16,0,0,0" HorizontalAlignment="Right" TextAlignment="Center"
                                                 Visibility="{Binding ViewModel.IsReturnMode, ElementName=PageRoot, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                 Background="#FFF6E5" BorderBrush="#F8D899"
                                                 IsEnabled="{x:Bind CanReturn}"
                                                 Text="{x:Bind ReturnInputQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 KeyDown="OnReturnQtyKeyDown"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Totals, like the bottom of the printed bill -->
                        <Grid Grid.Row="4" Padding="16,10" BorderBrush="#E5E9EF" BorderThickness="0,1,0,0" RowSpacing="3" HorizontalAlignment="Right" ColumnSpacing="28">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Subtotal" Foreground="#4B5563" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.DetailSubtotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="Discount" Foreground="#4B5563" HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.HasDiscount, Mode=OneWay}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.DetailDiscount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.HasDiscount, Mode=OneWay}"/>
                            <TextBlock Grid.Row="2" Text="Already returned" Foreground="#4B5563" HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.HasReturned, Mode=OneWay}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.DetailReturned, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Foreground="#B91C1C" HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.HasReturned, Mode=OneWay}"/>
                            <TextBlock Grid.Row="3" Text="{x:Bind ViewModel.NetLabel, Mode=OneWay}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.DetailNet, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="Bold" Foreground="#0B6E99" HorizontalAlignment="Right"/>
                        </Grid>

                        <!-- Return bar -->
                        <Border Grid.Row="5" Background="#FFF6E5" BorderBrush="#F8D899" BorderThickness="0,1,0,0" Padding="16,10" CornerRadius="0,0,8,8"
                                Visibility="{x:Bind ViewModel.IsReturnMode, Mode=OneWay}">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" Foreground="#4B5563">Refund to customer:
                                    <Run Text="{x:Bind ViewModel.RefundTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Foreground="#B45309" FontWeight="Bold"/>
                                </TextBlock>
                                <Button Grid.Column="1" Command="{x:Bind ViewModel.ReturnAllCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Return everything"/>
                                <Button Grid.Column="2" Command="{x:Bind ViewModel.CancelReturnCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel"/>
                                <Button Grid.Column="3" Command="{x:Bind ViewModel.ConfirmReturnCommand}" Style="{StaticResource PremiumButtonStyle}" Content="Confirm return &amp; print"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Nothing selected -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                            Visibility="{x:Bind ViewModel.SelectedSale, Mode=OneWay, Converter={StaticResource EmptyToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE8A1;" FontSize="40" Foreground="#CBD5E0"/>
                    <TextBlock Text="Pick a bill on the left" Foreground="#8A94A6"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="18">
                    <TextBlock FontSize="12" Foreground="#8A94A6"><Run Text="↑ ↓" FontWeight="SemiBold"/> next / previous bill</TextBlock>
                    <TextBlock FontSize="12" Foreground="#4B5563" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
