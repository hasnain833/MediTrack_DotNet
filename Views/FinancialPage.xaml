<Page
    x:Class="DChemist.Views.FinancialPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:CommunityToolkit.WinUI.UI.Controls"
    xmlns:vm="using:DChemist.ViewModels"
    xmlns:repo="using:DChemist.Repositories"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Page Body (Header removed) -->
        <Grid Grid.Row="1" Margin="40,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="450"/> <!-- Invoice List -->
                <ColumnDefinition Width="*"/>   <!-- Details -->
            </Grid.ColumnDefinitions>

            <!-- Invoice List & Search -->
            <Border Style="{StaticResource PremiumCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Search Controls -->
                    <Grid Padding="16" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="6" Margin="0,0,8,8">
                            <TextBlock Text="Bill Number" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBox PlaceholderText="BILL-..." Text="{x:Bind ViewModel.SearchInvoiceTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" Margin="8,0,0,8">
                            <TextBlock Text="Date" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                            <CalendarDatePicker Date="{x:Bind ViewModel.SearchDate, Mode=TwoWay}" PlaceholderText="Pick a date" HorizontalAlignment="Stretch" Height="32"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="6" Margin="0,4,8,0">
                            <TextBlock Text="Customer Name" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold"/>
                            <TextBox PlaceholderText="Search customer..." Text="{x:Bind ViewModel.SearchCustomerTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32"/>
                        </StackPanel>
                        <Button Grid.Row="1" Grid.Column="2" Command="{x:Bind ViewModel.SearchCommand}" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Bottom" Height="32" Padding="12,0">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                <TextBlock Text="Refresh" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Background="#F7FAFC" Padding="16,12" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0">
                        <TextBlock Text="Sales Bills" FontWeight="Bold" Foreground="#4A5568"/>
                    </Border>

                    <ListView Grid.Row="2"
                              ItemsSource="{x:Bind ViewModel.SalesHistory, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedSale, Mode=TwoWay}"
                              SelectionMode="Single" Padding="0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#F1F5F9"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="repo:SaleSummary">
                                <Grid Padding="16,12" Background="Transparent">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <TextBlock Text="{x:Bind BillNo}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Grid.Row="1" Text="{x:Bind Customer}" FontSize="12" Foreground="#718096" TextTrimming="CharacterEllipsis"/>
                                    
                                    <TextBlock Grid.Column="1" Text="{x:Bind Amount, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" Foreground="{StaticResource AccentAccent}" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind Date}" FontSize="11" Foreground="#A0AEC0" HorizontalAlignment="Right"/>
                                    
                                    <Border Grid.Column="2" Grid.RowSpan="2" Background="{x:Bind Status, Converter={StaticResource StatusToBackgroundConverter}}" 
                                            HorizontalAlignment="Right" VerticalAlignment="Center" Padding="8,2" CornerRadius="4">
                                        <TextBlock Text="{x:Bind Status}" FontSize="11" FontWeight="Medium" Foreground="{x:Bind Status, Converter={StaticResource StatusToForegroundConverter}}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- Details -->
            <Border Grid.Column="1" Margin="24,0,0,0" Style="{StaticResource PremiumCardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="#F9FAFB" Padding="20,16" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Items in Selection" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <ProgressRing IsActive="{x:Bind ViewModel.IsDetailsLoading, Mode=OneWay}" Width="16" Height="16" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Items List -->
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.SelectedInvoiceItems, Mode=OneWay}" Padding="0">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Background="#F9FAFB" Padding="20,10" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Medicine" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                                    <TextBlock Grid.Column="1" Text="Sold" FontSize="11" FontWeight="Bold" Foreground="#718096" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="Ret" FontSize="11" FontWeight="Bold" Foreground="#718096" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Rem" FontSize="11" FontWeight="Bold" Foreground="#718096" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="Price" FontSize="11" FontWeight="Bold" Foreground="#718096" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="Total" FontSize="11" FontWeight="Bold" Foreground="#718096" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="6" Text="Ret Qty" FontSize="11" FontWeight="Bold" Foreground="#718096" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="7" Text="Action" FontSize="11" FontWeight="Bold" Foreground="#718096" HorizontalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="54"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:InvoiceItemViewModel">
                                <Grid Padding="20,8" BorderThickness="0,0,0,1" BorderBrush="#F1F5F9" DataContext="{Binding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind MedicineName}" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Quantity}" VerticalAlignment="Center" FontSize="12" Foreground="#4A5568" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind ReturnedQuantity}" VerticalAlignment="Center" FontSize="12" Foreground="#E53E3E" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="{x:Bind RemainingQuantity}" VerticalAlignment="Center" FontSize="12" Foreground="#38A169" HorizontalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{x:Bind UnitPrice, Converter={StaticResource CurrencyConverter}}" VerticalAlignment="Center" FontSize="12" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Column="5" Text="{x:Bind CurrentTotal, Converter={StaticResource CurrencyConverter}}" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"/>
                                    
                                    <TextBox Grid.Column="6" Text="{x:Bind ReturnInputQty, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                             Width="50" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Height="28" Padding="4"/>
                                    
                                    <Button Grid.Column="7" Content="Return" 
                                            Click="ReturnItem_Click"
                                            IsEnabled="{x:Bind CanReturn, Mode=OneWay}"
                                            Background="#EBF8FF" Foreground="#3182CE" FontWeight="SemiBold"
                                            Padding="10,4" FontSize="11" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty State -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12"
                                Visibility="{x:Bind ViewModel.SelectedSale, Mode=OneWay, Converter={StaticResource EmptyToVisibilityConverter}}">
                        <FontIcon Glyph="&#xE990;" FontSize="48" Foreground="#CBD5E0"/>
                        <TextBlock Text="Select a bill to view items and process returns" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
