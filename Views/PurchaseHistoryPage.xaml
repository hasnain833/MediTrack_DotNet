<Page
    x:Class="DChemist.Views.PurchaseHistoryPage"
    x:Name="PageRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DChemist.Models"
    xmlns:vm="using:DChemist.ViewModels"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>
        <CollectionViewSource x:Name="InvoicesSource" Source="{x:Bind ViewModel.InvoiceGroups, Mode=OneWay}" IsSourceGrouped="True"/>
        <Style x:Key="ColHead" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A94A6"/>
            <Setter Property="CharacterSpacing" Value="60"/>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Toolbar (same as Bills) ============ -->
        <Border Background="White" BorderBrush="#E5E9EF" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid ColumnSpacing="14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Invoices" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" MaxWidth="380" HorizontalAlignment="Left"
                         PlaceholderText="Search invoice no. or supplier"
                         Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <ToggleButton x:Name="RangeToday" Content="Today" Tag="today" Click="OnRangeClick" Style="{StaticResource Chip}"/>
                    <ToggleButton x:Name="RangeWeek" Content="7 days" Tag="week" Click="OnRangeClick" Style="{StaticResource Chip}"/>
                    <ToggleButton x:Name="RangeMonth" Content="This month" Tag="month" Click="OnRangeClick" Style="{StaticResource Chip}"/>
                    <ToggleButton x:Name="RangeAll" Content="All" Tag="all" IsChecked="True" Click="OnRangeClick" Style="{StaticResource Chip}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="20" Margin="12,0,0,0">
                    <StackPanel>
                        <TextBlock Text="INVOICES" Style="{StaticResource ColHead}"/>
                        <TextBlock Text="{x:Bind ViewModel.InvoiceCount, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="NET PURCHASES" Style="{StaticResource ColHead}"/>
                        <TextBlock Text="{x:Bind ViewModel.InvoicesTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="16" FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Invoice list, grouped by day ============ -->
            <Border Background="White" BorderBrush="#E5E9EF" BorderThickness="0,0,1,0">
                <Grid>
                    <ListView x:Name="InvoiceList" ItemsSource="{x:Bind InvoicesSource.View, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedInvoice, Mode=TwoWay}" SelectionMode="Single">
                        <ListView.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate x:DataType="vm:InvoiceGroup">
                                        <Grid>
                                            <TextBlock Text="{x:Bind Label}" Style="{StaticResource ColHead}"/>
                                            <TextBlock Text="{x:Bind Total, Converter={StaticResource CurrencyConverter}}" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                                <GroupStyle.HeaderContainerStyle>
                                    <Style TargetType="ListViewHeaderItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Background" Value="#F8F9FA"/>
                                        <Setter Property="Padding" Value="14,6"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>
                                </GroupStyle.HeaderContainerStyle>
                            </GroupStyle>
                        </ListView.GroupStyle>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:PurchaseInvoice">
                                <Grid Padding="14,8" BorderThickness="0,0,0,1" BorderBrush="#F1F4F8" RowSpacing="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition/>
                                        <RowDefinition/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind InvoiceNo}" FontFamily="Cascadia Mono, Consolas" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind TotalAmount, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{x:Bind SupplierName}" FontSize="12" Foreground="#4B5563" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Foreground="#8A94A6" TextWrapping="Wrap"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24"
                               Visibility="{x:Bind ViewModel.InvoiceCount, Mode=OneWay, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                </Grid>
            </Border>

            <!-- ============ Invoice detail ============ -->
            <Grid Grid.Column="1" Padding="16" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Background="White" BorderBrush="#E5E9EF" BorderThickness="1" CornerRadius="8"
                        Visibility="{x:Bind ViewModel.HasSelectedInvoice, Mode=OneWay}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Padding="16,12" BorderBrush="#E5E9EF" BorderThickness="0,0,0,1" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="2">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{x:Bind ViewModel.SelectedInvoice.InvoiceNo, Mode=OneWay}" FontFamily="Cascadia Mono, Consolas" FontSize="19" FontWeight="SemiBold"/>
                                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16"/>
                                </StackPanel>
                                <TextBlock FontSize="13" Foreground="#4B5563">
                                    <Run Text="{x:Bind ViewModel.DetailFacts, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.IsNotEditMode, Mode=OneWay}">
                                <Button Command="{x:Bind ViewModel.EditInvoiceCommand}" Style="{StaticResource PremiumButtonStyle}" Content="Edit"/>
                                <Button Command="{x:Bind ViewModel.DeleteInvoiceCommand}" Style="{StaticResource SecondaryButtonStyle}" Foreground="#B91C1C" Content="Delete"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                        Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay}">
                                <Button Command="{x:Bind ViewModel.SaveEditCommand}" Style="{StaticResource PremiumButtonStyle}" Content="Save changes"/>
                                <Button Command="{x:Bind ViewModel.CancelEditCommand}" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Background="#FFF6E5" BorderBrush="#F8D899" BorderThickness="0,0,0,1" Padding="16,8"
                                Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay}">
                            <TextBlock Foreground="#B45309" FontSize="13">✎ Editing: change batch, quantity or cost. Stock updates when you save.</TextBlock>
                        </Border>

                        <!-- Read-only rows -->
                        <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.IsNotEditMode, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Background="#F8F9FA" Padding="16,8" BorderBrush="#E5E9EF" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="62"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="76"/>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="78"/>
                                    <ColumnDefinition Width="104"/>
                                    <ColumnDefinition Width="90"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="MEDICINE" Style="{StaticResource ColHead}"/>
                                <TextBlock Grid.Column="1" Text="BATCH" Style="{StaticResource ColHead}"/>
                                <TextBlock Grid.Column="2" Text="EXPIRY" Style="{StaticResource ColHead}"/>
                                <TextBlock Grid.Column="3" Text="QTY" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="BONUS" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="5" Text="INVOICE AMT" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="6" Text="DISC" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="7" Text="NET COST" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="8" Text="COST / TAB" Style="{StaticResource ColHead}" HorizontalAlignment="Right"/>
                            </Grid>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.InvoiceItems, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:InventoryBatch">
                                        <Grid Padding="16,8" BorderThickness="0,0,0,1" BorderBrush="#F1F4F8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="62"/>
                                                <ColumnDefinition Width="100"/>
                                                <ColumnDefinition Width="76"/>
                                                <ColumnDefinition Width="104"/>
                                                <ColumnDefinition Width="78"/>
                                                <ColumnDefinition Width="104"/>
                                                <ColumnDefinition Width="90"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind MedicineName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <Border Background="#FEF3C7" CornerRadius="4" Padding="5,0" VerticalAlignment="Center" Visibility="{x:Bind IsNet}">
                                                    <TextBlock Text="NET" FontSize="10" FontWeight="Bold" Foreground="#92400E"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{x:Bind BatchNo}" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{x:Bind ExpiryText}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{x:Bind FormattedQuantity}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{x:Bind BonusText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#4B5563"/>
                                            <TextBlock Grid.Column="5" Text="{x:Bind InvoiceAmountOrNet, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#4B5563"/>
                                            <TextBlock Grid.Column="6" Text="{x:Bind DiscOrPaidText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#4B5563"/>
                                            <TextBlock Grid.Column="7" Text="{x:Bind PurchaseTotalPrice, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="Bold"/>
                                            <TextBlock Grid.Column="8" Text="{x:Bind UnitCost, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0B6E99"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- Editable rows -->
                        <Grid Grid.Row="2" Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Background="#FFF6E5" Padding="16,8" BorderBrush="#F8D899" BorderThickness="0,0,0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="MEDICINE" Style="{StaticResource ColHead}" Foreground="#92400E"/>
                                <TextBlock Grid.Column="1" Text="BATCH" Style="{StaticResource ColHead}" Foreground="#92400E" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="QTY" Style="{StaticResource ColHead}" Foreground="#92400E" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="NET COST" Style="{StaticResource ColHead}" Foreground="#92400E" HorizontalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="COST / TAB" Style="{StaticResource ColHead}" Foreground="#92400E" HorizontalAlignment="Right"/>
                            </Grid>
                            <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.EditableItems, Mode=OneWay}" SelectionMode="None">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:EditableInvoiceItem">
                                        <Grid Padding="16,5" BorderThickness="0,0,0,1" BorderBrush="#FEF3C7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="100"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{x:Bind MedicineName}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            <TextBox Grid.Column="1" Margin="4,0" TextAlignment="Center" KeyDown="OnEditRowKeyDown"
                                                     Text="{Binding EditBatchNo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Grid.Column="2" Margin="4,0" TextAlignment="Center" PlaceholderText="0" KeyDown="OnEditRowKeyDown"
                                                     Text="{Binding EditQuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Grid.Column="3" Margin="4,0" TextAlignment="Right" PlaceholderText="0.00" Tag="cost" KeyDown="OnEditRowKeyDown"
                                                     Text="{Binding EditTotalCostText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding EditUnitCost, Converter={StaticResource CurrencyConverter}, Mode=OneWay}"
                                                       VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0B6E99" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>

                        <!-- Totals -->
                        <Grid Grid.Row="3" Padding="16,10" BorderBrush="#E5E9EF" BorderThickness="0,1,0,0" RowSpacing="3" HorizontalAlignment="Right" ColumnSpacing="28">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Invoice total (as printed)" Foreground="#4B5563" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.InvoiceGross, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="Saved by bonus, discount &amp; net prices" Foreground="#4B5563" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.InvoiceSaved, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Foreground="#047857" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="2" Text="Net cost" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsNotEditMode, Mode=OneWay}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.InvoiceNet, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="Bold" Foreground="#0B6E99" HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.IsNotEditMode, Mode=OneWay}"/>
                            <TextBlock Grid.Row="2" Text="Edited total" FontWeight="SemiBold" Foreground="#B45309" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.EditTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="22" FontWeight="Bold" Foreground="#B45309" HorizontalAlignment="Right" Visibility="{x:Bind ViewModel.IsEditMode, Mode=OneWay}"/>
                        </Grid>
                    </Grid>
                </Border>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                            Visibility="{x:Bind ViewModel.SelectedInvoice, Mode=OneWay, Converter={StaticResource EmptyToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE896;" FontSize="40" Foreground="#CBD5E0"/>
                    <TextBlock Text="Pick an invoice on the left" Foreground="#8A94A6"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="18">
                    <TextBlock FontSize="12" Foreground="#8A94A6"><Run Text="↑ ↓" FontWeight="SemiBold"/> next / previous invoice</TextBlock>
                    <TextBlock FontSize="12" Foreground="#8A94A6">When editing, <Run Text="Enter" FontWeight="SemiBold"/> moves to the next box and saves after the last one</TextBlock>
                    <TextBlock FontSize="12" Foreground="#4B5563" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
