<Page
    x:Class="DChemist.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DChemist.ViewModels"
    xmlns:repo="using:DChemist.Repositories"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Grid Background="#F8F9FA">
        <ScrollViewer Padding="0,0,0,32">
            <StackPanel Spacing="32">

                <!-- Main Content Area (Header removed) -->
                <StackPanel Padding="60,32,60,0" Spacing="40">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Low Stock Items List -->
                        <Border Style="{StaticResource PremiumCardStyle}" Padding="24" Grid.Column="0">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE7BA;" Foreground="#D93025" FontSize="18"/>
                                    <TextBlock Text="Low Stock Items" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <ListView ItemsSource="{x:Bind ViewModel.LowStockList, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="repo:DashboardMedicineAlert">
                                            <StackPanel Padding="0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{x:Bind SubText}" FontSize="12" Foreground="#D93025"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="All items well stocked." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,32,0,0"
                                           Visibility="{x:Bind ViewModel.LowStockList.Count, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Expiring Soon List -->
                        <Border Style="{StaticResource PremiumCardStyle}" Padding="24" Grid.Column="1">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE916;" Foreground="#F9AB00" FontSize="18"/>
                                    <TextBlock Text="Expiring Soon" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <ListView ItemsSource="{x:Bind ViewModel.ExpiringList, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="repo:DashboardMedicineAlert">
                                            <StackPanel Padding="0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                <TextBlock Text="{x:Bind Name}" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{x:Bind SubText}" FontSize="12" Foreground="#F9AB00"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="No imminent expiries." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,32,0,0"
                                           Visibility="{x:Bind ViewModel.ExpiringList.Count, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>

                        <!-- Recent Sales List -->
                        <Border Style="{StaticResource PremiumCardStyle}" Padding="24" Grid.Column="2">
                            <StackPanel Spacing="16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE94C;" Foreground="#1E8E3E" FontSize="18"/>
                                    <TextBlock Text="Recent Sales" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                </StackPanel>
                                <ListView ItemsSource="{x:Bind ViewModel.RecentSales, Mode=OneWay}" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RecentSaleItem">
                                            <Grid Padding="0,8" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{x:Bind Invoice}" FontWeight="Medium" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{x:Bind Date, Converter={StaticResource DateConverter}}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{x:Bind Total, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" Foreground="#1E8E3E" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <TextBlock Text="No recent sales to display." FontSize="14" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,32,0,0"
                                           Visibility="{x:Bind ViewModel.RecentSales.Count, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Width="60" Height="60" Foreground="{StaticResource AccentAccent}"
                      Canvas.ZIndex="100"/>
    </Grid>
</Page>
