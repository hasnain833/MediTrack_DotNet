<Page
    x:Class="DChemist.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DChemist.ViewModels"
    xmlns:repo="using:DChemist.Repositories"
    xmlns:utils="using:DChemist.Utils"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <Page.Resources>
        <utils:BoolToBrushConverter x:Key="UrgencyBrushConverter" TrueBrush="#B91C1C" FalseBrush="#B45309"/>
        <utils:BoolToBrushConverter x:Key="TodayBarBrushConverter" TrueBrush="#3a7bd5" FalseBrush="#B9EEFB"/>
        <Style x:Key="KpiLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A94A6"/>
            <Setter Property="CharacterSpacing" Value="60"/>
        </Style>
        <Style x:Key="Kpi" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E5E9EF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
    </Page.Resources>

    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ============ Greeting + shortcuts ============ -->
        <Border Background="White" BorderBrush="#E5E9EF" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Bind ViewModel.TodayText, Mode=OneWay}" Foreground="#4B5563" VerticalAlignment="Center"/>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="16" Height="16"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Click="OnNewSaleClick" Style="{StaticResource PremiumButtonStyle}" Content="New sale"/>
                    <Button Click="OnNewPurchaseClick" Style="{StaticResource SecondaryButtonStyle}" Content="New purchase"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1">
            <StackPanel Padding="16" Spacing="16">

                <!-- ============ Today's numbers ============ -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Kpi}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="SALES TODAY" Style="{StaticResource KpiLabel}"/>
                            <TextBlock Text="{x:Bind ViewModel.SalesToday, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.VsLastWeekText, Mode=OneWay}" FontSize="12"
                                       Foreground="{x:Bind ViewModel.IsUpVsLastWeek, Mode=OneWay, Converter={StaticResource StatusFgConverter}}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Kpi}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="BILLS TODAY" Style="{StaticResource KpiLabel}"/>
                            <TextBlock Text="{x:Bind ViewModel.BillsToday, Mode=OneWay}" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.LastBillText, Mode=OneWay}" FontSize="12" Foreground="#4B5563"/>
                        </StackPanel>
                    </Border>
                    <!-- Profit reveals cost prices, so admins only -->
                    <Border Grid.Column="2" Style="{StaticResource Kpi}" Visibility="{x:Bind ViewModel.IsAdmin}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind ViewModel.ProfitLabel, Mode=OneWay}" Style="{StaticResource KpiLabel}"/>
                            <TextBlock Text="{x:Bind ViewModel.ProfitToday, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind ViewModel.MarginText, Mode=OneWay}" FontSize="12" Foreground="#4B5563"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Style="{StaticResource Kpi}" Background="#FFF6E5" BorderBrush="#F8D899">
                        <StackPanel Spacing="2">
                            <TextBlock Text="NEEDS ATTENTION" Style="{StaticResource KpiLabel}" Foreground="#B45309"/>
                            <TextBlock Text="{x:Bind ViewModel.AttentionCount, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" Foreground="#B45309"/>
                            <TextBlock Text="{x:Bind ViewModel.AttentionSummary, Mode=OneWay}" FontSize="12" Foreground="#B45309"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ============ Needs attention ============ -->
                    <Border Background="White" BorderBrush="#E5E9EF" BorderThickness="1" CornerRadius="8" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Padding="14,10">
                                <TextBlock Text="Needs attention" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <ToggleButton x:Name="AttnAll" Content="{x:Bind ViewModel.AllChipText, Mode=OneWay}" Tag="all" IsChecked="True" Click="OnAttentionFilterClick" Style="{StaticResource Chip}"/>
                                    <ToggleButton x:Name="AttnExp" Content="{x:Bind ViewModel.ExpiryChipText, Mode=OneWay}" Tag="exp" Click="OnAttentionFilterClick" Style="{StaticResource Chip}"/>
                                    <ToggleButton x:Name="AttnLow" Content="{x:Bind ViewModel.LowChipText, Mode=OneWay}" Tag="low" Click="OnAttentionFilterClick" Style="{StaticResource Chip}"/>
                                </StackPanel>
                            </Grid>
                            <ListView ItemsSource="{x:Bind ViewModel.Attention, Mode=OneWay}" SelectionMode="None" MaxHeight="420">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="repo:AttentionItem">
                                        <Grid Padding="14,7" BorderBrush="#F1F4F8" BorderThickness="0,1,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{x:Bind Info}" FontSize="11" Foreground="#8A94A6"/>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Tag}" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{x:Bind IsUrgent, Converter={StaticResource UrgencyBrushConverter}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                            <TextBlock Text="Nothing needs attention. Stock and expiries look fine." Margin="14,4,14,14" Foreground="#047857"
                                       Visibility="{x:Bind ViewModel.AttentionCount, Mode=OneWay, Converter={StaticResource EmptyToVisibilityConverter}}"/>
                        </StackPanel>
                    </Border>

                    <!-- ============ This week + recent bills ============ -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#E5E9EF" BorderThickness="1" CornerRadius="8" VerticalAlignment="Top">
                        <StackPanel>
                            <Grid Padding="14,10">
                                <TextBlock Text="Sales this week" FontSize="15" FontWeight="SemiBold"/>
                                <TextBlock Text="{x:Bind ViewModel.WeekTotal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Foreground="#4B5563" HorizontalAlignment="Right"/>
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.WeekBars, Mode=OneWay}" Margin="14,0,14,10" Height="140">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="10"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DayBar">
                                        <Grid Width="34" ToolTipService.ToolTip="{x:Bind Tooltip}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Height="{x:Bind BarHeight}" VerticalAlignment="Bottom" CornerRadius="3,3,0,0"
                                                    Background="{x:Bind IsToday, Converter={StaticResource TodayBarBrushConverter}}"/>
                                            <TextBlock Grid.Row="1" Text="{x:Bind Day}" FontSize="11" Foreground="#8A94A6" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Padding="14,10" BorderBrush="#E5E9EF" BorderThickness="0,1,0,0">
                                <TextBlock Text="Recent bills" FontSize="15" FontWeight="SemiBold"/>
                                <HyperlinkButton Content="All bills →" Click="OnAllBillsClick" HorizontalAlignment="Right" Padding="0"/>
                            </Grid>
                            <ItemsControl ItemsSource="{x:Bind ViewModel.RecentSales, Mode=OneWay}" Margin="0,0,0,8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RecentSaleItem">
                                        <Grid Padding="14,6" BorderBrush="#F1F4F8" BorderThickness="0,1,0,0">
                                            <TextBlock Text="{x:Bind Invoice}" FontFamily="Cascadia Mono, Consolas" FontSize="13"/>
                                            <TextBlock Text="{x:Bind TimeText}" Foreground="#8A94A6" HorizontalAlignment="Center"/>
                                            <TextBlock Text="{x:Bind Total, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
