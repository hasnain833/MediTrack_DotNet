<Page
    x:Class="DChemist.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DChemist.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    RequestedTheme="Light">

    <!-- Layout: brand panel in the app's nav colour on the left, sign-in form on the right. -->
    <Grid Background="{ThemeResource AppBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="5*" MaxWidth="560"/>
            <ColumnDefinition Width="7*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Brand panel ============ -->
        <Grid Background="{StaticResource PremiumBackgroundBrush}" Padding="48">
            <StackPanel VerticalAlignment="Center" Spacing="10">
                <Rectangle Width="40" Height="4" RadiusX="2" RadiusY="2" Fill="{StaticResource AccentAccent}" HorizontalAlignment="Left"/>
                <TextBlock FontSize="40" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Foreground="White">
                    D.<Run Text=" Chemist" Foreground="{StaticResource AccentAccent}"/>
                </TextBlock>
                <TextBlock Text="Billing, stock and purchases for the pharmacy counter." Foreground="#A7B0C0" FontSize="15" TextWrapping="Wrap" MaxWidth="340" HorizontalAlignment="Left"/>
            </StackPanel>
            <TextBlock VerticalAlignment="Bottom" Foreground="#6B7686" FontSize="12">
                Version <Run Text="{x:Bind AppVersion}"/>
            </TextBlock>
        </Grid>

        <!-- ============ Sign-in form ============ -->
        <Border Grid.Column="1" Background="White" BorderBrush="#E5E9EF" BorderThickness="1" CornerRadius="10"
                Width="380" Padding="32,28" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="14">
                <StackPanel Spacing="2">
                    <TextBlock Text="Sign in" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Text="Use your counter account." Foreground="#4B5563"/>
                </StackPanel>

                <TextBox x:Name="UsernameBox" Header="Username" PlaceholderText="e.g. admin"
                         Text="{x:Bind ViewModel.Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnUsernameKeyDown"/>

                <PasswordBox x:Name="PasswordBox" Header="Password" PasswordRevealMode="Peek"
                             Password="{x:Bind ViewModel.Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnKeyDown"/>

                <Border Background="#FDECEC" CornerRadius="6" Padding="10,8"
                        Visibility="{x:Bind ViewModel.ErrorMessage, Converter={StaticResource StringToVisibilityConverter}, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="#B91C1C" TextWrapping="Wrap" FontSize="13"/>
                </Border>

                <Grid>
                    <Button Command="{x:Bind ViewModel.LoginCommand}" Style="{StaticResource PremiumButtonStyle}"
                            HorizontalAlignment="Stretch" Height="44" FontSize="15" FontWeight="SemiBold" Content="Sign in"/>
                    <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="20" Height="20"
                                  Foreground="White" HorizontalAlignment="Right" Margin="0,0,14,0"/>
                </Grid>

                <TextBlock Text="Enter moves to the next field and signs in." FontSize="12" Foreground="#8A94A6" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
