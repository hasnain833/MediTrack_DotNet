<UserControl
    x:Class="DChemist.Views.ExpiryReturnSheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DChemist.Models"
    Width="794" Height="1123" Background="White" RequestedTheme="Light">
    <!-- One A4 page (96 dpi) of the expiring-stock return list for one supplier -->
    <UserControl.Resources>
        <Style x:Key="Th" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Td" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </UserControl.Resources>

    <Grid Padding="40,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: pharmacy (left) / document (right) -->
        <Grid BorderBrush="#111827" BorderThickness="0,0,0,2" Padding="0,0,0,10">
            <StackPanel>
                <TextBlock x:Name="PharmacyNameText" FontSize="20" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock x:Name="PharmacyInfoText" FontSize="10.5" Foreground="#4B5563" TextWrapping="Wrap" MaxWidth="420"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right">
                <TextBlock Text="EXPIRY RETURN LIST" FontSize="16" FontWeight="Bold" Foreground="#B91C1C" HorizontalAlignment="Right"/>
                <TextBlock x:Name="DateText" FontSize="10.5" Foreground="#4B5563" HorizontalAlignment="Right"/>
                <TextBlock x:Name="PageText" FontSize="10.5" Foreground="#4B5563" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <!-- Supplier box -->
        <Border Grid.Row="1" Margin="0,12,0,12" Background="#F3F4F6" CornerRadius="4" Padding="12,8">
            <Grid>
                <StackPanel>
                    <TextBlock Text="SUPPLIER" FontSize="9" FontWeight="SemiBold" Foreground="#6B7280"/>
                    <TextBlock x:Name="SupplierText" FontSize="14" FontWeight="SemiBold" Foreground="#111827"/>
                </StackPanel>
                <TextBlock x:Name="ScopeText" FontSize="10.5" Foreground="#4B5563" HorizontalAlignment="Right" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </Border>

        <!-- Table -->
        <StackPanel Grid.Row="2">
            <Grid Background="#1F2937" Height="28" Padding="8,0" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="118"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="#" Style="{StaticResource Th}"/>
                <TextBlock Grid.Column="1" Text="Medicine" Style="{StaticResource Th}"/>
                <TextBlock Grid.Column="2" Text="Batch" Style="{StaticResource Th}"/>
                <TextBlock Grid.Column="3" Text="Expiry" Style="{StaticResource Th}"/>
                <TextBlock Grid.Column="4" Text="Status" Style="{StaticResource Th}"/>
                <TextBlock Grid.Column="5" Text="Qty" Style="{StaticResource Th}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="6" Text="Invoice (date)" Style="{StaticResource Th}"/>
                <TextBlock Grid.Column="7" Text="Cost/unit" Style="{StaticResource Th}" HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="8" Text="Value" Style="{StaticResource Th}" HorizontalAlignment="Right"/>
            </Grid>
            <ItemsControl x:Name="RowsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ExpiringStockRow">
                        <Grid Height="26" Padding="8,0" ColumnSpacing="6" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="118"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind No}" Style="{StaticResource Td}" Foreground="#6B7280"/>
                            <TextBlock Grid.Column="1" Text="{x:Bind MedicineName}" Style="{StaticResource Td}" FontWeight="SemiBold"/>
                            <TextBlock Grid.Column="2" Text="{x:Bind BatchNo}" Style="{StaticResource Td}"/>
                            <TextBlock Grid.Column="3" Text="{x:Bind ExpiryText}" Style="{StaticResource Td}"/>
                            <TextBlock Grid.Column="4" Text="{x:Bind StatusText}" Style="{StaticResource Td}"/>
                            <TextBlock Grid.Column="5" Text="{x:Bind RemainingUnits}" Style="{StaticResource Td}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="6" Text="{x:Bind InvoiceText}" Style="{StaticResource Td}"/>
                            <TextBlock Grid.Column="7" Text="{x:Bind UnitCostText}" Style="{StaticResource Td}" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="8" Text="{x:Bind ValueText}" Style="{StaticResource Td}" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Totals (last page only) -->
            <Grid x:Name="TotalsRow" Height="30" Padding="8,0" Background="#F3F4F6" Visibility="Collapsed">
                <TextBlock x:Name="TotalsLabel" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TotalsValue" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>

        <!-- Signatures (last page only) -->
        <Grid x:Name="SignRow" Grid.Row="3" ColumnSpacing="60" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel BorderBrush="#111827" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                <TextBlock Text="Handed over by (pharmacy)" FontSize="10" Foreground="#4B5563"/>
            </StackPanel>
            <StackPanel Grid.Column="1" BorderBrush="#111827" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                <TextBlock Text="Received by (supplier representative)" FontSize="10" Foreground="#4B5563"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
