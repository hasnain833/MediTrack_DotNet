<Page
    x:Class="DChemist.Views.StockInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DChemist.Models"
    xmlns:viewmodels="using:DChemist.ViewModels"
    xmlns:utils="using:DChemist.Utils"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}" RequestedTheme="Light">

    <Page.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <utils:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <utils:CurrencyConverter x:Key="CurrencyConverter"/>
        <utils:DateConverter x:Key="DateConverter"/>

        <DataTemplate x:Key="SmallHeader" x:DataType="x:String">
            <TextBlock Text="{x:Bind}" FontSize="12" FontWeight="SemiBold" Foreground="#718096" Margin="0,0,0,2"/>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ Header Banner ═══════════════ -->
        <Border Background="{StaticResource PremiumBackgroundBrush}" CornerRadius="0,0,24,24" Padding="60,24" Margin="0,0,0,8">
            <Grid>
                <StackPanel Spacing="2">
                    <TextBlock Text="Purchase Entry" FontSize="26" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Add stock to inventory using supplier invoices." FontSize="13" Foreground="#A0AEC0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Spacing="20">
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                               FontSize="13" FontWeight="SemiBold" Foreground="#A0AEC0"
                               VerticalAlignment="Center" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="60,0,60,32">
            <StackPanel Spacing="20" MaxWidth="1200" HorizontalAlignment="Stretch">
                
                <!-- 1. Invoice Header Section -->
                <Border Style="{StaticResource PremiumCardStyle}" Padding="24" Background="White">
                    <Grid ColumnSpacing="24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="SupplierComboBox" ItemsSource="{x:Bind ViewModel.Suppliers, Mode=OneWay}"
                                  Header="Supplier"
                                  DisplayMemberPath="Name" 
                                  SelectedItem="{x:Bind ViewModel.SelectedSupplier, Mode=OneWay}"
                                  Text="{x:Bind ViewModel.SessionSupplierName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True" HorizontalAlignment="Stretch" CornerRadius="8"
                                  SelectionChanged="OnSupplierSelectionChanged"
                                  PreviewKeyDown="OnInputKeyDown"/>

                        <TextBox x:Name="InvoiceNoBox" Grid.Column="1" Header="Invoice #" 
                                 Text="{x:Bind ViewModel.SessionInvoiceNo, Mode=TwoWay}" CornerRadius="8"
                                 KeyDown="OnInputKeyDown" PlaceholderText="INV-000"/>

                        <TextBox x:Name="InvoiceDateBox" Grid.Column="2" Header="Date" 
                                 Text="{x:Bind ViewModel.SessionInvoiceDateText, Mode=TwoWay}" CornerRadius="8"
                                 KeyDown="OnInputKeyDown" PlaceholderText="DD/MM/YYYY"/>
                    </Grid>
                </Border>

                <!-- 2. Fast Search Box (Floating above table) -->
                <Border Style="{StaticResource PremiumCardStyle}" Padding="24" Background="White" BorderBrush="{StaticResource AccentAccent}" BorderThickness="1">
                    <AutoSuggestBox x:Name="MedicineSearchBox"
                                    PlaceholderText="Search Medicine to add to list (Enter to select)..."
                                    QueryIcon="Find"
                                    TextMemberPath="Name"
                                    ItemsSource="{x:Bind ViewModel.SearchSuggestions, Mode=OneWay}"
                                    Text="{x:Bind ViewModel.EntryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    QuerySubmitted="OnMedicineSearch_QuerySubmitted"
                                    FontSize="18" FontWeight="Medium">
                        <AutoSuggestBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding ManufacturerName}" FontSize="11" Foreground="#718096"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                </Border>

                <!-- 3. Editable Invoice Table -->
                <Border Style="{StaticResource PremiumCardStyle}" Padding="0" Background="White">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Table Headers -->
                        <Border Background="#F8FAFC" Padding="24,12" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="MEDICINE NAME" FontSize="11" FontWeight="Bold" Foreground="#718096"/>
                                <TextBlock Grid.Column="1" Text="QTY (PACKS)" FontSize="11" FontWeight="Bold" Foreground="#718096" Margin="12,0,0,0"/>
                                <TextBlock Grid.Column="2" Text="PRICE / PACK" FontSize="11" FontWeight="Bold" Foreground="#718096" Margin="12,0,0,0"/>
                                <TextBlock Grid.Column="3" Text="COST / UNIT" FontSize="11" FontWeight="Bold" Foreground="#718096" TextAlignment="Right"/>
                                <TextBlock Grid.Column="4" Text="TOTAL COST" FontSize="11" FontWeight="Bold" Foreground="#718096" TextAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Table Content -->
                        <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ReceivingItems, Mode=OneWay}" SelectionMode="None" Padding="0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:ReceivingItem">
                                    <Grid Padding="24,8" BorderThickness="0,0,0,1" BorderBrush="#F1F5F9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="48"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind MedicineName}" FontWeight="SemiBold" FontSize="14" Foreground="#2D3748"/>
                                            <TextBlock Text="{x:Bind EntryMode}" FontSize="10" Foreground="#718096"/>
                                        </StackPanel>

                                        <!-- Editable Qty -->
                                        <TextBox Grid.Column="1" Margin="8,4" 
                                                 Text="{Binding PackQuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="0" TextAlignment="Center" CornerRadius="4"
                                                 KeyDown="OnRowInputKeyDown" Loaded="OnRowControlLoaded"/>

                                        <!-- Editable Price / Pack -->
                                        <TextBox Grid.Column="2" Margin="8,4" 
                                                 Text="{Binding PackPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="0.00" TextAlignment="Right" CornerRadius="4"
                                                 KeyDown="OnRowInputKeyDown"/>

                                        <TextBlock Grid.Column="3" Text="{Binding UnitCost, Converter={StaticResource CurrencyConverter}}" VerticalAlignment="Center" TextAlignment="Right" Foreground="#718096"/>
                                        <TextBlock Grid.Column="4" Text="{Binding PurchaseTotalPrice, Converter={StaticResource CurrencyConverter}}" VerticalAlignment="Center" TextAlignment="Right" FontWeight="Bold" Foreground="{StaticResource AccentAccent}"/>
                                        
                                        <Button Grid.Column="5" Click="OnRemoveItem_Click" Tag="{x:Bind}" Background="Transparent" BorderThickness="0" Padding="8" HorizontalAlignment="Right">
                                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#EF4444"/>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- 4. Summary & Save -->
                <Border Style="{StaticResource PremiumCardStyle}" Padding="32" Background="White">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="64">
                            <StackPanel>
                                <TextBlock Text="Total Items" FontSize="12" Foreground="#718096" Margin="0,0,0,4"/>
                                <TextBlock Text="{x:Bind ViewModel.ReceivingItems.Count, Mode=OneWay}" FontSize="28" FontWeight="Bold"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Grand Total Cost" FontSize="12" Foreground="#718096" Margin="0,0,0,4"/>
                                <TextBlock Text="{x:Bind ViewModel.TotalSessionCost, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentAccent}"/>
                            </StackPanel>
                        </StackPanel>

                        <Button Command="{x:Bind ViewModel.SaveAllCommand}" 
                                HorizontalAlignment="Right" Height="64" Width="300"
                                Style="{StaticResource PremiumButtonStyle}"
                                IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                                CornerRadius="16">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <FontIcon Glyph="&#xE74E;" Foreground="White" FontSize="20"/>
                                <TextBlock Text="Complete" Foreground="White" FontWeight="Bold" FontSize="18"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="64" Height="64" 
                      Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentAccent}"/>
    </Grid>
</Page>
