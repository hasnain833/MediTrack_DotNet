<Page
    x:Class="DChemist.Views.StockInPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DChemist.Models"
    xmlns:viewmodels="using:DChemist.ViewModels"
    xmlns:utils="using:DChemist.Utils"
    mc:Ignorable="d"
    Background="{ThemeResource AppBackgroundBrush}" RequestedTheme="Light">

    <Page.Resources>
        <utils:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <utils:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
        <utils:CurrencyConverter x:Key="CurrencyConverter"/>
        <utils:DateConverter x:Key="DateConverter"/>

        <DataTemplate x:Key="SmallHeader" x:DataType="x:String">
            <TextBlock Text="{x:Bind}" FontSize="12" FontWeight="SemiBold" Foreground="#718096" Margin="0,0,0,2"/>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════ Header Banner ═══════════════ -->
        <Border Background="{StaticResource PremiumBackgroundBrush}" CornerRadius="0,0,24,24" Padding="40,28">
            <Grid>
                <StackPanel Spacing="2" Margin="60,0,0,0">
                    <TextBlock Text="Purchase Entry" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Add stock to inventory using supplier invoices." FontSize="13" Foreground="#A0AEC0"/>
                </StackPanel>

                <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           FontSize="13" FontWeight="SemiBold" Foreground="#A0AEC0"
                           MaxWidth="400" TextWrapping="Wrap" TextAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ═══════════════ Page Body ═══════════════ -->
        <Grid Grid.Row="1" Margin="40,20,40,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. Invoice Header Card -->
            <Border Grid.Row="0" Style="{StaticResource PremiumCardStyle}" Padding="28,20" Background="White" Margin="0,0,0,16">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ComboBox x:Name="SupplierComboBox"
                              ItemsSource="{x:Bind ViewModel.Suppliers, Mode=OneWay}"
                              Header="Supplier"
                              DisplayMemberPath="Name"
                              SelectedItem="{x:Bind ViewModel.SelectedSupplier, Mode=OneWay}"
                              Text="{x:Bind ViewModel.SessionSupplierName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True" HorizontalAlignment="Stretch" CornerRadius="8"
                              SelectionChanged="OnSupplierSelectionChanged"
                              PreviewKeyDown="OnInputKeyDown"/>

                    <TextBox x:Name="InvoiceNoBox" Grid.Column="1" Header="Invoice #"
                             Text="{x:Bind ViewModel.SessionInvoiceNo, Mode=TwoWay}" CornerRadius="8"
                             KeyDown="OnInputKeyDown" PlaceholderText="INV-000"/>

                    <TextBox x:Name="InvoiceDateBox" Grid.Column="2" Header="Date"
                             Text="{x:Bind ViewModel.SessionInvoiceDateText, Mode=TwoWay}" CornerRadius="8"
                             KeyDown="OnInputKeyDown" PlaceholderText="DD/MM/YYYY"/>
                </Grid>
            </Border>

            <!-- 2. Search Box -->
            <Border Grid.Row="1" Style="{StaticResource PremiumCardStyle}" Padding="20,14"
                    Background="White" BorderBrush="{StaticResource AccentAccent}" BorderThickness="1.5"
                    Margin="0,0,0,16">
                <AutoSuggestBox x:Name="MedicineSearchBox"
                                PlaceholderText="Search medicine to add to list (press Enter to select)..."
                                QueryIcon="Find"
                                TextMemberPath="Name"
                                ItemsSource="{x:Bind ViewModel.SearchSuggestions, Mode=OneWay}"
                                Text="{x:Bind ViewModel.EntryName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                QuerySubmitted="OnMedicineSearch_QuerySubmitted"
                                FontSize="16" FontWeight="Medium">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,4">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ManufacturerName}" FontSize="11" Foreground="#718096"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </Border>

            <!-- 3. Invoice Table (stretches to fill remaining space) -->
            <Border Grid.Row="2" Style="{StaticResource PremiumCardStyle}" Padding="0"
                    Background="White" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column Headers — static labels for fixed columns -->
                    <Border Background="#F8FAFC" Padding="24,14" BorderThickness="0,0,0,1" BorderBrush="#E2E8F0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="48"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="MEDICINE NAME" FontSize="11" FontWeight="Bold" Foreground="#718096" VerticalAlignment="Center"/>
                            <!-- QTY header: label changes per row via QtyLabel, so we show a generic "QTY" here -->
                            <TextBlock Grid.Column="1" Text="QTY" FontSize="11" FontWeight="Bold" Foreground="#718096" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="TOTAL PRICE" FontSize="11" FontWeight="Bold" Foreground="#718096" TextAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="COST / UNIT" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentAccent}" TextAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Rows -->
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.ReceivingItems, Mode=OneWay}"
                              SelectionMode="None" Padding="0" Background="Transparent">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ReceivingItem">
                                <Grid Padding="24,10" BorderThickness="0,0,0,1" BorderBrush="#F1F5F9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Medicine Name + Pkg Dimension -->
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind MedicineName}" FontWeight="SemiBold" FontSize="14" Foreground="#2D3748"/>
                                        <TextBlock Text="{x:Bind PkgDimension}" FontSize="10" Foreground="#718096"/>
                                    </StackPanel>

                                    <!-- QTY input — label below shows BOX or TABS -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBox x:Name="QtyBox"
                                                 Text="{Binding PackQuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="0" TextAlignment="Center" CornerRadius="6"
                                                 Margin="8,0"
                                                 KeyDown="OnRowInputKeyDown" Loaded="OnRowControlLoaded"/>
                                        <TextBlock Text="{x:Bind QtyLabel}" FontSize="9" Foreground="#94A3B8"
                                                   TextAlignment="Center" Margin="8,2,8,0"/>
                                    </StackPanel>

                                    <!-- TOTAL PRICE input (total amount paid, not per-pack) -->
                                    <TextBox Grid.Column="2" x:Name="PriceBox"
                                             Text="{Binding PackPriceText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             PlaceholderText="Total paid (e.g. 1200)" TextAlignment="Right" CornerRadius="6"
                                             Margin="8,2"
                                             KeyDown="OnRowInputKeyDown"/>

                                    <!-- COST / UNIT — calculated: TotalPrice ÷ TotalTablets -->
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding UnitCost, Converter={StaticResource CurrencyConverter}}"
                                               VerticalAlignment="Center" TextAlignment="Right"
                                               FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentAccent}"/>

                                    <Button Grid.Column="4" Click="OnRemoveItem_Click" Tag="{x:Bind}"
                                            Background="Transparent" BorderThickness="0" Padding="8"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#EF4444"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>



            <!-- 4. Summary & Save Card -->
            <Border Grid.Row="3" Style="{StaticResource PremiumCardStyle}" Padding="28,20" Background="White">
                <Grid>
                    <StackPanel Orientation="Horizontal" Spacing="48" VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="Total Items" FontSize="12" Foreground="#718096" Margin="0,0,0,4"/>
                            <TextBlock Text="{x:Bind ViewModel.ReceivingItems.Count, Mode=OneWay}"
                                       FontSize="30" FontWeight="Bold" Foreground="#2D3748"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Grand Total Cost" FontSize="12" Foreground="#718096" Margin="0,0,0,4"/>
                            <TextBlock Text="{x:Bind ViewModel.TotalSessionCost, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                       FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentAccent}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Command="{x:Bind ViewModel.SaveAllCommand}"
                            HorizontalAlignment="Right" Height="56" Width="240"
                            Style="{StaticResource PremiumButtonStyle}"
                            IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
                            VerticalAlignment="Center"
                            CornerRadius="14">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon Glyph="&#xE74E;" Foreground="White" FontSize="18"/>
                            <TextBlock Text="Complete Purchase" Foreground="White" FontWeight="Bold" FontSize="15"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <ProgressRing IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" Width="64" Height="64"
                      Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Foreground="{StaticResource AccentAccent}"/>
    </Grid>
</Page>
