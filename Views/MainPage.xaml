<Page
    x:Class="DChemist.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DChemist.Views"
    xmlns:vm="using:DChemist.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DChemist.Models"
    xmlns:utils="using:DChemist.Utils"
    x:Name="PageRoot"
    mc:Ignorable="d">

    <Page.Resources>
        <utils:SidebarLogoutColorConverter x:Key="SidebarLogoutColorConverter"/>
    </Page.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Navigation -->
        <Border Grid.Row="0"
                Background="{StaticResource PremiumBackgroundBrush}"
                Padding="24,0"
                Height="56"
                Canvas.ZIndex="100">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Horizontal Menu -->
                <ListView Grid.Column="1" 
                          ItemsSource="{x:Bind ViewModel.NavigationItems}"
                          SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                          SelectionMode="Single"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource HorizontalNavigationItemStyle}"/>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:NavigationItem">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="{x:Bind Icon}" 
                                          FontSize="15"/>
                                <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <!-- User Area -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{x:Bind ViewModel.OpenInNewWindowCommand}"
                            CommandParameter="{x:Bind ViewModel.SelectedItem, Mode=OneWay}"
                            Style="{StaticResource TextBlockButtonStyle}" 
                            Padding="12" CornerRadius="8"
                            ToolTipService.ToolTip="Open current page in new window">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8A7;" 
                                  Foreground="White" FontSize="20"/>
                    </Button>

                    <Button Command="{x:Bind ViewModel.LogoutCommand}"
                            Style="{StaticResource TextBlockButtonStyle}" 
                            Padding="12" CornerRadius="8"
                            ToolTipService.ToolTip="Logout">
                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE7E8;" 
                                  Foreground="White" FontSize="20"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Frame x:Name="ContentFrame" Grid.Row="1" Padding="0"/>
    </Grid>
</Page>

