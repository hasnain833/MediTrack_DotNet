<Page
    x:Class="DChemist.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DChemist.Views"
    xmlns:vm="using:DChemist.ViewModels"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:DChemist.Models"
    xmlns:utils="using:DChemist.Utils"
    x:Name="PageRoot"
    mc:Ignorable="d">

    <Page.Resources>
        <utils:SidebarLogoutColorConverter x:Key="SidebarLogoutColorConverter"/>
    </Page.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Navigation -->
        <!-- Top bar: brand · page tabs · user. Text-only tabs so all of them fit on a 16–17" screen. -->
        <Border Grid.Row="0" Background="{StaticResource PremiumBackgroundBrush}" Padding="16,0" Height="48" Canvas.ZIndex="100">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock VerticalAlignment="Center" FontSize="17" FontWeight="Bold" FontFamily="Segoe UI Variable Display" Foreground="White" Margin="0,0,10,0">
                    D.<Run Text=" Chemist" Foreground="{StaticResource AccentAccent}"/>
                </TextBlock>

                <!-- Scrolling is off: the scroll indicator used to show up as a stray box at the top. -->
                <ListView Grid.Column="1"
                          ItemsSource="{x:Bind ViewModel.NavigationItems}"
                          SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                          SelectionMode="Single"
                          VerticalAlignment="Center"
                          ScrollViewer.HorizontalScrollMode="Disabled"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.VerticalScrollMode="Disabled"
                          ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsStackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource HorizontalNavigationItemStyle}"/>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:NavigationItem">
                            <TextBlock Text="{x:Bind Title}" FontSize="13" FontWeight="SemiBold"/>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind ViewModel.CurrentUser.Username, Mode=OneWay}" Foreground="#A7B0C0" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Command="{x:Bind ViewModel.OpenInNewWindowCommand}"
                            CommandParameter="{x:Bind ViewModel.SelectedItem, Mode=OneWay}"
                            Style="{StaticResource TextBlockButtonStyle}" Padding="8"
                            ToolTipService.ToolTip="Open this page in a new window">
                        <FontIcon Glyph="&#xE8A7;" Foreground="#A7B0C0" FontSize="16"/>
                    </Button>
                    <Button Command="{x:Bind ViewModel.LogoutCommand}"
                            Style="{StaticResource TextBlockButtonStyle}" Padding="8"
                            ToolTipService.ToolTip="Log out">
                        <FontIcon Glyph="&#xE7E8;" Foreground="#A7B0C0" FontSize="16"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Frame x:Name="ContentFrame" Grid.Row="1" Padding="0"/>
    </Grid>
</Page>

